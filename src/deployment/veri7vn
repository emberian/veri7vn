#!/bin/sh
# Trusted recipient bootstrap. Resolve current once, before starting package code.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
base=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd -P)
if [ -f "$base/manifest.json" ]; then
  package=$base
else
  package=$(CDPATH= cd -P -- "$base/current" && pwd -P)
fi
immutable=$package
if [ "$(basename -- "$(dirname -- "$package")")" = generations ]; then
  immutable=$(dirname -- "$package")
fi
os_user=$(/usr/bin/id -un)
state=
expect_state=no
for argument in "$@"; do
  if [ "$expect_state" = yes ]; then state=$argument; expect_state=no
  elif [ "$argument" = -- ]; then break
  elif [ "$argument" = --state ]; then expect_state=yes
  fi
done
canonical_directory() {
  if [ -d "$1" ]; then
    (CDPATH= cd -P -- "$1" && pwd -P)
  elif [ -e "$1" ] || [ -L "$1" ]; then
    echo 'deployment: state must resolve to a directory' >&2; return 1
  else
    parent=$(canonical_directory "$(dirname -- "$1")") || return 1
    leaf=$(basename -- "$1")
    case "$leaf" in
      ..) dirname -- "$parent" ;;
      .) printf '%s\n' "$parent" ;;
      *) printf '%s/%s\n' "${parent%/}" "$leaf" ;;
    esac
  fi
}
if [ "${1:-}" = launch ] && [ -n "$state" ]; then
  case "$state" in /*) ;; *) state=$PWD/$state ;; esac
  state=$(canonical_directory "$state")
  case "$state/" in "$immutable/"*) echo 'deployment: mutable state must be outside immutable generations' >&2; exit 1 ;; esac
fi
# Never execute settings from mutable workspace input. Durable workspace/images
# are passed explicitly; settings and process scaffolding are invocation-local.
temporary_home=$(/usr/bin/mktemp -d /tmp/veri7vn-bootstrap.XXXXXXXX)
trap 'rm -rf -- "$temporary_home"' EXIT HUP INT TERM
user_home=$temporary_home
# Start with an allowlist: initialized Isabelle, injected JVM options, shell
# startup hooks and caller CLASSPATH must not influence the pinned closure.
run() {
  /usr/bin/env -i \
  HOME="$temporary_home" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  USER="$os_user" LOGNAME="$os_user" \
  TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" \
  USER_HOME="$user_home" \
  VERI7VN_BOOTSTRAP_HOME="$temporary_home" \
  CLASSPATH="$package/bootstrap/veri7vn-launcher.jar" \
  "$package/runtime/bin/isabelle" java \
  veri7vn.deployment.DeploymentMain --package "$package" "$@"
}
run "$@"
