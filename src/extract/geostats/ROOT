(* Lane S11-geometry-stats: the Oracle7 geometry (geometry, geometry-v3,
   geometry-v4) and statistics (statistics, statistics-v2, statistics-v3)
   specialists as one HOL kernel family, exported to SML. The base session only
   loads Isabelle's verified interval arithmetic (HOL-Decision_Procs.Approximation,
   no HOL-Analysis), as lane G's quantity session does, so the kernel session
   rebuilds quickly on top of it. *)
session Veri7vn_GeoStats_Base in base = HOL +
  options [document = false, threads = 2]
  sessions
    "HOL-Decision_Procs"
    "HOL-Library"
  theories
    GeoStats_Base

session Veri7vn_GeoStats = Veri7vn_GeoStats_Base +
  options [document = false, threads = 2]
  theories
    GeoStats_Num
    GeoStats_Geometry
    GeoStats_Stats
    GeoStats_Export
