(* Lane O19-facts: the Oracle7 FactsOrgan family (22 specialists, 21 stores) as
   one HOL interpreter plus transcribed rule tables, exported to SML. The base
   session holds only the interpreter and its theorems, so a table change
   rebuilds only the top session. *)
session Veri7vn_Facts_Base in base = HOL +
  options [document = false, threads = 2]
  theories
    Facts_Kernel

session Veri7vn_Facts = Veri7vn_Facts_Base +
  options [document = false, threads = 2]
  theories
    Facts_Tables
    Facts_Rows
    Facts_Export
