(* Lane D: the Oracle7 acoustics specialist as a HOL kernel, exported to SML.
   The base session only loads Isabelle's verified interval arithmetic
   (HOL-Decision_Procs.Approximation, which needs no HOL-Analysis), so the
   kernel session rebuilds quickly on top of it. *)
session Veri7vn_Acoustics_Base in base = HOL +
  options [document = false, threads = 2]
  sessions
    "HOL-Decision_Procs"
  theories
    Acoustics_Base

session Veri7vn_Acoustics = Veri7vn_Acoustics_Base +
  options [document = false, threads = 2]
  sessions
    "Veri7vn_Commons"
  theories
    Acoustics
    Acoustics_Export
