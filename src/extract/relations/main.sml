(* decide_main.sml - UNTRUSTED I/O around the exported HOL decision (Relation_Reader_Code, generated by
   src/extract/relations/Relation_Reader_Export.thy from Relation_Reader.thy and Relation_Tables.thy:
   decide_spec over the specialist's table spec_of). One JSON object per stdin line, one JSON outcome per
   stdout line. "spec <id>" dumps that specialist's table for the answerer's startup check. The JSON
   reader/writer is lane W5-01's (tools/reader-novels/decide_main.sml), hand-rolled and not verified; the
   decision and the tables are.

   Input:  {"id":..,"spec":s,"kind_conflict":b,"past":b,"qwords":[s],"vwords":[[value,[s]]],
            "attempts":[{"key":s,"dir":"fwd"|"inv","idx":n,"slot_ok":b,"capped":b,
                         "candidates":[cand],"subjects":[cand]}]}
           cand = {"qid":n,"links":n,"dom":b,"cls":[n],"canc":[[n]],"oanc":[[n]],"held":[n],
                   "label":value,"rows":[[n,value]],"complete":b,"pron":b}
   Output: {"id":..,"outcome":"answer","subject":n,"property":n,"value":value}
         | {"id":..,"outcome":"decline","property":n,"subject":n}
         | {"id":..,"outcome":"incomplete"} | {"id":..,"outcome":"silent"} | {"outcome":"error",..}
   where value is ["e",n] | ["l",s] | ["b"]. *)

structure Json = struct
  datatype t = Null | Bool of bool | Num of IntInf.int | Str of string | Arr of t list | Obj of (string * t) list
  exception Bad of string

  fun utf8 (cp : int) : string =
    let fun ch n = String.str (Char.chr n) in
      if cp < 0x80 then ch cp
      else if cp < 0x800 then ch (0xC0 + cp div 64) ^ ch (0x80 + cp mod 64)
      else if cp < 0x10000 then ch (0xE0 + cp div 4096) ^ ch (0x80 + (cp div 64) mod 64) ^ ch (0x80 + cp mod 64)
      else ch (0xF0 + cp div 262144) ^ ch (0x80 + (cp div 4096) mod 64) ^ ch (0x80 + (cp div 64) mod 64)
           ^ ch (0x80 + cp mod 64)
    end

  fun parse (s : string) : t =
    let
      val n = String.size s
      fun peek i = if i < n then String.sub (s, i) else #"\000"
      fun ws i = if i < n andalso Char.isSpace (String.sub (s, i)) then ws (i + 1) else i
      fun expect (c, i) = if peek i = c then i + 1 else raise Bad ("expected " ^ String.str c)
      fun hex4 i =
        case (if i + 4 <= n then StringCvt.scanString (Int.scan StringCvt.HEX) (String.substring (s, i, 4)) else NONE)
          of SOME v => v | NONE => raise Bad "bad \\u escape"
      fun str (i, acc) =
        case peek i of
          #"\"" => (String.concat (rev acc), i + 1)
        | #"\\" =>
            (case peek (i + 1) of
               #"\"" => str (i + 2, "\"" :: acc) | #"\\" => str (i + 2, "\\" :: acc)
             | #"/" => str (i + 2, "/" :: acc) | #"b" => str (i + 2, "\b" :: acc)
             | #"f" => str (i + 2, "\012" :: acc) | #"n" => str (i + 2, "\n" :: acc)
             | #"r" => str (i + 2, "\r" :: acc) | #"t" => str (i + 2, "\t" :: acc)
             | #"u" =>
                 let val hi = hex4 (i + 2) in
                   if hi >= 0xD800 andalso hi < 0xDC00 andalso peek (i + 6) = #"\\" andalso peek (i + 7) = #"u"
                   then let val lo = hex4 (i + 8)
                        in str (i + 12, utf8 (0x10000 + (hi - 0xD800) * 1024 + (lo - 0xDC00)) :: acc) end
                   else str (i + 6, utf8 hi :: acc)
                 end
             | _ => raise Bad "bad escape")
        | #"\000" => raise Bad "unterminated string"
        | c => str (i + 1, String.str c :: acc)
      fun num i =
        let fun go j = if Char.isDigit (peek j) orelse (j = i andalso peek j = #"-") then go (j + 1) else j
            val j = go i
        in case IntInf.fromString (String.substring (s, i, j - i)) of
             SOME v => (Num v, j) | NONE => raise Bad "bad number"
        end
      fun value i =
        let val i = ws i in
          case peek i of
            #"{" => obj (ws (i + 1), [])
          | #"[" => arr (ws (i + 1), [])
          | #"\"" => let val (v, j) = str (i + 1, []) in (Str v, j) end
          | #"t" => if String.isPrefix "true" (String.extract (s, i, NONE)) then (Bool true, i + 4) else raise Bad "t"
          | #"f" => if String.isPrefix "false" (String.extract (s, i, NONE)) then (Bool false, i + 5) else raise Bad "f"
          | #"n" => if String.isPrefix "null" (String.extract (s, i, NONE)) then (Null, i + 4) else raise Bad "n"
          | _ => num i
        end
      and arr (i, acc) =
        if peek i = #"]" then (Arr (rev acc), i + 1)
        else let val (v, j) = value i val j = ws j in
          case peek j of #"," => arr (ws (j + 1), v :: acc) | #"]" => (Arr (rev (v :: acc)), j + 1)
                       | _ => raise Bad "array" end
      and obj (i, acc) =
        if peek i = #"}" then (Obj (rev acc), i + 1)
        else let val (k, j) = str (expect (#"\"", i), []) val j = expect (#":", ws j)
                 val (v, j) = value j val j = ws j in
          case peek j of #"," => obj (ws (j + 1), (k, v) :: acc) | #"}" => (Obj (rev ((k, v) :: acc)), j + 1)
                       | _ => raise Bad "object" end
      val (v, j) = value 0
    in if ws j = n then v else raise Bad "trailing input" end

  fun quote (s : string) : string =
    let fun esc c =
          case c of #"\"" => "\\\"" | #"\\" => "\\\\" | #"\n" => "\\n" | #"\r" => "\\r" | #"\t" => "\\t"
          | c => if Char.ord c < 0x20 then "\\u00" ^ StringCvt.padLeft #"0" 2 (Int.fmt StringCvt.HEX (Char.ord c))
                 else String.str c
    in "\"" ^ String.translate esc s ^ "\"" end

  fun field (Obj kvs) k = (case List.find (fn (k', _) => k' = k) kvs of SOME (_, v) => v | NONE => Null)
    | field _ _ = Null
  fun bool v = case v of Bool b => b | _ => raise Bad "bool"
  fun int v = case v of Num i => i | _ => raise Bad "int"
  fun string v = case v of Str x => x | _ => raise Bad "string"
  fun list v = case v of Arr xs => xs | Null => [] | _ => raise Bad "list"
  fun show v =
    case v of Null => "null" | Bool b => (if b then "true" else "false") | Num i => IntInf.toString i
    | Str x => quote x | Arr xs => "[" ^ String.concatWith "," (map show xs) ^ "]"
    | Obj kvs => "{" ^ String.concatWith "," (map (fn (k, x) => quote k ^ ":" ^ show x) kvs) ^ "}"
end

structure Main = struct
  structure R = Relation_Reader_Code
  open Json

  val nat = R.natural_of_integer
  fun unnat n = Num (R.integer_of_natural n)
  fun nats v = map (nat o int) (list v)

  fun value v =
    case list v of
      [Str "e", Num q] => R.Entity (nat q)
    | [Str "l", Str s] => R.Literal s
    | [Str "b"] => R.Blank
    | _ => raise Bad "value"

  fun showValue v =
    case v of
      R.Entity q => Arr [Str "e", unnat q]
    | R.Literal s => Arr [Str "l", Str s]
    | R.Blank => Arr [Str "b"]

  fun row r = case list r of [p, v] => (nat (int p), value v) | _ => raise Bad "row"

  fun candidate c =
    R.Candidate_ext (nat (int (field c "qid")), nat (int (field c "links")), bool (field c "dom"),
                     nats (field c "cls"), map nats (list (field c "canc")), map nats (list (field c "oanc")),
                     nats (field c "held"), value (field c "label"), map row (list (field c "rows")),
                     bool (field c "complete"), bool (field c "pron"), ())

  fun direction d = case string d of "fwd" => R.Fwd | "inv" => R.Inv | _ => raise Bad "dir"

  fun attempt a =
    R.Attempt_ext (string (field a "key"), direction (field a "dir"), nat (int (field a "idx")),
                   bool (field a "slot_ok"), map candidate (list (field a "candidates")),
                   map candidate (list (field a "subjects")), bool (field a "capped"), ())

  fun vword x = case list x of [v, ws] => (value v, map string (list ws)) | _ => raise Bad "vwords"

  fun features e =
    R.Question_features_ext (bool (field e "kind_conflict"), bool (field e "past"),
                             map string (list (field e "qwords")), map vword (list (field e "vwords")), ())

  fun natsOut xs = Arr (map unnat xs)

  fun showSpec name =
    case R.spec_of name of
      NONE => show (Obj [("outcome", Str "error"), ("error", Str ("no such specialist: " ^ name))])
    | SOME sp =>
        show (Obj [("id", Str (R.sid sp)),
                   ("readers", Arr (map (fn r => Arr [Str (R.rkey r), unnat (R.rprop r), unnat (R.nfwd r),
                                                      unnat (R.ninv r), natsOut (R.dfwd r), natsOut (R.dinv r)])
                                        (R.readers sp))),
                   ("roots", natsOut (R.roots sp)), ("occ", natsOut (R.occs sp)), ("exclude", natsOut (R.excl sp)),
                   ("guard", Bool (R.guard sp))])

  fun handle_line line =
    if String.isPrefix "spec " line then showSpec (String.extract (line, 5, NONE))
    else
      let
        val e = parse line
        val id = field e "id"
      in
        case R.spec_of (string (field e "spec")) of
          NONE => show (Obj [("id", id), ("outcome", Str "error"), ("error", Str "no such specialist")])
        | SOME sp =>
          (case R.decide_spec sp (features e) (map attempt (list (field e "attempts"))) of
             R.Answer (s, (p, v)) =>
               show (Obj [("id", id), ("outcome", Str "answer"), ("subject", unnat s),
                          ("property", unnat p), ("value", showValue v)])
           | R.Decline (p, s) =>
               show (Obj [("id", id), ("outcome", Str "decline"), ("property", unnat p), ("subject", unnat s)])
           | R.Incomplete => show (Obj [("id", id), ("outcome", Str "incomplete")])
           | R.Silent => show (Obj [("id", id), ("outcome", Str "silent")]))
      end
      handle Bad msg => show (Obj [("outcome", Str "error"), ("error", Str msg)])

  fun loop () =
    case TextIO.inputLine TextIO.stdIn of
      NONE => ()
    | SOME l =>
        let val l = if String.isSuffix "\n" l then String.substring (l, 0, String.size l - 1) else l in
          TextIO.output (TextIO.stdOut, handle_line l ^ "\n"); TextIO.flushOut TextIO.stdOut; loop ()
        end
end

val _ = Main.loop ()
