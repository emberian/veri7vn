{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "veri7vn editable specialist package, revision 0",
  "description": "Descriptor structure only. Native export resolution, safety, assurance, and executable correctness are not established by this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "veri7vn.package/0"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "not": {
            "pattern": "\\s"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9][a-z0-9.-]*)?$",
          "not": {
            "pattern": "\\s"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "description"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "not": {
              "pattern": "[^A-Za-z0-9_./-]"
            },
            "description": "Portable package-relative path; loading must also enforce filesystem containment."
          },
          "role": {
            "enum": [
              "source",
              "example",
              "documentation",
              "data"
            ]
          }
        },
        "required": [
          "path",
          "role"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
            "not": {
              "pattern": "\\s"
            }
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9][a-z0-9.-]*)?$",
            "not": {
              "pattern": "\\s"
            }
          }
        },
        "required": [
          "package_id",
          "version"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "theories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "session",
        "theories"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "not": {
              "pattern": "\\s"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "specification": {
            "$ref": "#/$defs/native_locator"
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/native_locator"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "executable": {
            "$ref": "#/$defs/native_locator"
          }
        },
        "required": [
          "id",
          "title",
          "specification",
          "contracts"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "package",
    "files",
    "requires",
    "capabilities"
  ],
  "$defs": {
    "native_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "theory",
        "name"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "minItems": 1
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "native"
        ]
      }
    }
  ]
}
