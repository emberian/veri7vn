+definition scope_checkpoint_session_plan_matches :: "authority_state \<Rightarrow> nat \<Rightarrow>
+    observation_context \<Rightarrow> (nat \<times> nat \<times> nat \<times> nat list) list \<Rightarrow>
+    (nat \<times> nat) list \<Rightarrow> bool" where
+  "scope_checkpoint_session_plan_matches s rid original plan required =
+    (\<exists>r\<in>set (requests s). request_id r=rid \<and>
+      request_observation r=RequireObservation original None \<and>
+      request_session r=Some (observed_session original) \<and>
+      list_all (\<lambda>g. goal_output_slot g\<noteq>None) (request_goals r) \<and>
+      map (\<lambda>g. (goal_id g,the (goal_output_slot g),goal_interpretation g,
+        map dependency_goal (goal_dependencies g))) (request_goals r)=plan \<and>
+      map (\<lambda>rg. (goal_id (snd rg),the (goal_output_slot (snd rg))))
+        (filter (\<lambda>rg. request_id (fst rg)=rid) (required_native_children s))=required)"
+definition scope_checkpoint_original_source :: "authority_state \<Rightarrow> nat \<Rightarrow>
+    observation_context \<Rightarrow> nat \<Rightarrow> nat list option" where
+  "scope_checkpoint_original_source s rid original input =
+    (case filter (\<lambda>r. request_id r=rid) (requests s) of [r] \<Rightarrow>
+      (if request_session r=Some (observed_session original) \<and>
+          request_observation r=RequireObservation original None then
+        (case filter (\<lambda>value. retained_id value=input) (retained_values s) of [value] \<Rightarrow>
+          (if conversation_input_context s value=Some original \<and>
+            list_all (\<lambda>n. n\<in>set (request_dependencies r)) (input # retained_dependencies value)
+           then Some (remdups (input # retained_dependencies value)) else None)
+        | _ \<Rightarrow> None)
+       else None)
+     | _ \<Rightarrow> None)"
 definition scope_checkpoint_parent_active :: "authority_state \<Rightarrow> nat \<Rightarrow> bool" where
   "scope_checkpoint_parent_active s rid = (\<exists>r\<in>set (requests s).
     request_id r=rid \<and> \<not>request_cancelled r \<and> parent_accessible s r)"
