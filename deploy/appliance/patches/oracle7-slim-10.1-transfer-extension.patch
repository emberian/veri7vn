@@ -0,0 +1,22 @@
+"""Literal independent expected times and unit/assumption controls; untrusted scorer."""
+from decimal import Decimal, InvalidOperation
+import re
+RESULT = re.compile(r"\A(Ideal|Estimated) transfer time: (-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?) seconds\.")
+
+
+def ok(item, reply):
+    asserted = reply.get('status') == 'answered'
+    if not item.get('valid', True):
+        return not asserted, asserted
+    if not asserted:
+        return False, False
+    match = RESULT.match(str(reply.get('response', '')))
+    if not match or match[1].lower() != item['mode']:
+        return False, True
+    if item['mode'] == 'ideal' and 'Assumes 100% utilization' not in reply['response']:
+        return False, True
+    try:
+        got, want = Decimal(match[2]), Decimal(item['a'])
+        return abs(got-want) <= max(Decimal('1e-12'), abs(want)*Decimal('1e-10')), True
+    except (InvalidOperation, KeyError):
+        return False, True
