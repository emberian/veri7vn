+        low = high = (astro(year), month, day)
+    elif precision == 10:
+        low, high = (astro(year), month, 1), (astro(year), month, last_day(year, month))
+    elif precision == 9:
+        low, high = (astro(year), 1, 1), (astro(year), 12, 31)
