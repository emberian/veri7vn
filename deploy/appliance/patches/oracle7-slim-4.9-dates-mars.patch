+def interval(value, subject, property):
+    """Conservative bounds for ordering; uncertain/unknown qualifiers never prove order.
+
+    Refinement can only narrow the coarse source period, so retaining that wider
+    period is safe. Explicit earliest/latest bounds narrow only in the same
+    calendar. Circa/disputed and unrecognized qualifiers remain unknown.
+    """
+    records = selected(value, subject, property)
+    if not records:
+        return None
+    intervals = []
+    try:
+        for record in records:
+            qualifiers = record.get('qualifiers', {})
+            if set(qualifiers) - {'P4241', 'P7452', 'P1319', 'P1326'}:
+                return None
+            bounds = _time_interval(record['mainsnak']['datavalue']['value'])
+            if bounds is None:
+                return None
+            calendar, low, high = bounds
+            for prop in ('P1319', 'P1326'):
+                for snak in qualifiers.get(prop, []):
+                    if snak.get('snaktype') != 'value' or snak.get('datavalue', {}).get('type') != 'time':
+                        return None
+                    bound = _time_interval(snak['datavalue']['value'])
+                    if bound is None or bound[0] != calendar:
+                        return None
+                    if prop == 'P1319':
