+        n = (abs(year)-1)//unit+1
+        ys = ((n-1)*unit+1, n*unit) if year > 0 else (-n*unit, -(n-1)*unit-1)
+        low, high = (astro(ys[0]), 1, 1), (astro(ys[1]), 12, 31)
+    return time['calendarmodel'], low, high
