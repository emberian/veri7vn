+        return self._c426_answer(
+            res, '%s. From the Wikidata relation store: %s.' % (comparison['answer'], comparison['receipt']),
+            refs, {'via': 'comparison', 'method': 'source_date_intervals',
+                   'steps': comparison['steps'], 'answer': comparison['answer']}, t0)
 
