+        if len({b[0] for b in intervals}) != 1:
+            return None
+        return intervals[0][0], min(b[1] for b in intervals), max(b[2] for b in intervals)
+    except (ValueError, KeyError, TypeError, IndexError, AttributeError):
+        return None
