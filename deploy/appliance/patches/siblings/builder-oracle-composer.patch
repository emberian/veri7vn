diff --git a/workbench/swarm/test_composer_safety.py b/workbench/swarm/test_composer_safety.py
new file mode 100644
--- /dev/null
+++ b/workbench/swarm/test_composer_safety.py
@@ -0,0 +1,48 @@
+"""Counterexamples for source emission, differential read-back and typed search."""
+import importlib.util
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location('composer_safety_subject', Path(__file__).with_name('composer_v3.py'))
+composer = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = composer
+spec.loader.exec_module(composer)
+
+
+class ComposerSafety(unittest.TestCase):
+    def test_title_stays_data(self):
+        with tempfile.TemporaryDirectory() as directory:
+            marker = Path(directory)/'injected'
+            title = '"""\nfrom pathlib import Path\nPath('+repr(str(marker))+').write_text("bad")\n"""'
+            sol = {'kind':'expr','py_expr':'x1 * 2','js_expr':'x1 * 2','derivation':'test'}
+            py, js = composer.program_source(sol, ['x1'], title)
+            self.assertTrue(composer.read_back(py, [[2],[3]], [4,6])[0])
+            self.assertFalse(marker.exists())
+            self.assertTrue(js.startswith('// "'))
+
+    def test_readback_count_exit_and_shape(self):
+        for stdout, code in [('[]',0), ('[2,4,6]',0), ('[2,4]',1), ('{}',0)]:
+            with patch.object(composer.subprocess, 'run', return_value=SimpleNamespace(stdout=stdout,returncode=code)):
+                self.assertFalse(composer.read_back('ignored', [[1],[2]], [2,4])[0])
+
+    def test_equal_examples_preserve_distinct_dimensions(self):
+        bank = composer.enumerate_exprs([[1,1],[2,2]], max_size=1, labels=['length (m)','duration (s)'])
+        self.assertEqual(len({e.dim for e in bank.values() if e.op[0]=='in'}), 2)
+
+    def test_bank_budget_is_a_hard_bound(self):
+        bank = composer.enumerate_exprs([[1],[2]], max_size=3, bank_cap=10)
+        self.assertLessEqual(len(bank), 10)
+        for cap in (0, True, composer.BANK_CAP+1):
+            with self.assertRaises(ValueError): composer.enumerate_exprs([[1],[2]], bank_cap=cap)
+
+    def test_negative_positional_input_terminates(self):
+        with self.assertRaises(ValueError): composer._in_base(-1, 2)
+        py, _ = composer.program_source({'kind':'positional','base':2,'derivation':'base two'}, ['x1'], 'binary')
+        self.assertFalse(composer.read_back(py, [[-1]], ['-1'])[0])
+
+
+if __name__ == '__main__': unittest.main()
