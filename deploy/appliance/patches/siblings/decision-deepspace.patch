diff --git a/test_decision_contract.py b/test_decision_contract.py
new file mode 100644
index 0000000..037d57d
--- /dev/null
+++ b/test_decision_contract.py
@@ -0,0 +1,16 @@
+import unittest
+from deepspace.runtime import scenario, score
+
+class ScoreContract(unittest.TestCase):
+    def test_missing_required_action_targets_are_not_correct(self):
+        for fault, action in (("sensor_bias", "mark_sensor_invalid"), ("wheel_friction", "switch_to_spare_wheel"), ("heater_stuck_on", "switch_heater_backup")):
+            self.assertFalse(score(scenario(fault, 1), {"actions": [(100, action, {})], "damage": False})["ok"])
+
+    def test_pre_fault_action_does_not_solve_future_fault(self):
+        params = scenario("sensor_bias", 1)
+        target = {"zone": params["zone"], "sensor": params["sensor"]}
+        self.assertFalse(score(params, {"actions": [(0, "mark_sensor_invalid", target)], "damage": False})["ok"])
+        self.assertTrue(score(params, {"actions": [(100, "mark_sensor_invalid", target)], "damage": False})["ok"])
+
+if __name__ == "__main__":
+    unittest.main()
