diff --git a/test_decision_contract.py b/test_decision_contract.py
new file mode 100644
index 0000000..e0724c1
--- /dev/null
+++ b/test_decision_contract.py
@@ -0,0 +1,36 @@
+import copy
+import unittest
+from trafficcop.model import decide
+
+class DecisionContract(unittest.TestCase):
+    def request(self):
+        return {"state": {"observation": "button returns wrong result"}, "questions": {"next": {"options": [["a", "repair button behavior"], ["b", "repair button behavior"]]}}}
+
+    def test_equal_bindings_abstain_under_reordering(self):
+        a = self.request()
+        b = copy.deepcopy(a)
+        b["questions"]["next"]["options"].reverse()
+        for request in (a, b):
+            answer = decide(request)["answers"]["next"]
+            self.assertIsNone(answer["choice"])
+            self.assertTrue(answer["abstained"])
+            self.assertEqual(answer["receipt"]["ambiguous_options"], ["a", "b"])
+
+    def test_receipt_binds_questions_and_no_invented_probabilities(self):
+        a = self.request()
+        b = copy.deepcopy(a)
+        b["questions"]["next"]["options"] = [["a", "repair button behavior"]]
+        self.assertNotEqual(decide(a)["input_hash"], decide(b)["input_hash"])
+        answer = decide(b)["answers"]["next"]
+        self.assertEqual(answer["choice"], "a")
+        self.assertEqual(answer["probabilities"], {})
+        self.assertIsNone(answer["smoothed_success_rate"])
+
+    def test_duplicate_option_identity_refused(self):
+        a = self.request()
+        a["questions"]["next"]["options"][1][0] = "a"
+        with self.assertRaises(ValueError):
+            decide(a)
+
+if __name__ == "__main__":
+    unittest.main()
