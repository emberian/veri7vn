diff --git a/test_decision_contract.py b/test_decision_contract.py
new file mode 100644
index 0000000..e34bf9a
--- /dev/null
+++ b/test_decision_contract.py
@@ -0,0 +1,37 @@
+import sqlite3
+import unittest
+from contextlib import closing
+from agent import gate, latest_values
+
+class ForecastContract(unittest.TestCase):
+    def results(self, method, entity, value):
+        return [(i, i+3600, entity, "used_pct", method, value, 1, 0) for i in range(30)]
+
+    def check_gate(self, rows):
+        with closing(sqlite3.connect(":memory:")) as db:
+            db.execute("CREATE TABLE forecast(made,target,entity,signal,method,value,scored,actual)")
+            db.executemany("INSERT INTO forecast VALUES(?,?,?,?,?,?,?,?)", rows)
+            return gate(db)["used_pct@1h"]
+
+    def test_unpaired_baseline_is_not_evidence(self):
+        self.assertIsNone(self.check_gate(self.results("naive", "a", 100) + self.results("trend6h", "b", 1))["admitted"])
+
+    def test_matching_improvement_and_duplicate_refusal(self):
+        baseline = self.results("naive", "a", 100)
+        method = self.results("trend6h", "a", 1)
+        self.assertEqual(self.check_gate(baseline + method)["admitted"], "trend6h")
+        self.assertIsNone(self.check_gate(baseline + method + [method[0]])["admitted"])
+
+    def test_equal_perfect_forecasts_did_not_beat_baseline(self):
+        self.assertIsNone(self.check_gate(self.results("naive", "a", 0) + self.results("trend6h", "a", 0))["admitted"])
+
+    def test_epoch_zero_is_a_real_timestamp(self):
+        with closing(sqlite3.connect(":memory:")) as db:
+            db.execute("CREATE TABLE fact(ts,entity,signal,value,source)")
+            db.execute("INSERT INTO fact VALUES(0,'disk:a','used_pct',98,'supplied')")
+            stamp, rows = latest_values(db)
+            self.assertEqual(stamp, 0)
+            self.assertEqual(len(rows), 1)
+
+if __name__ == "__main__":
+    unittest.main()
