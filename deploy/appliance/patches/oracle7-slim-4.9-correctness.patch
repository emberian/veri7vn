+class ResearchTests(unittest.TestCase):
+    def test_reject_unknown_missing_incompatible_or_wrong_quantity(self):
+        for response in ("The length is 42 parsecs.", "There are 42 apples.", "The length is 42.",
+                         "The length is 42 kg.", "The height is 42 m.", "Result: 42 m/s.",
+                         "The length is not 42 m.", "I cannot tell the length: 42 m.",
+                         "Result: 42 m*kg.", "Result: 42 m · s.", "Result: 1,23 m.",
+                         "Result: 42 m per second.", "[specialist-v3] Result: unknown."):
+            with self.subTest(response=response):
+                self.assertIsNone(point.research_value(response, "length (m)")[0])
+
+    def test_reject_ambiguous_or_nonfinite(self):
+        for response in ("Result: 5 m or 7 m.", "The length is 5 m, maybe 7 m.", "Result: 1e999 m."):
+            with self.subTest(response=response):
+                self.assertIsNone(point.research_value(response, "length (m)")[0])
+
+    def test_known_conversion_and_explicit_same_units(self):
+        self.assertEqual(point.research_value("The length is 2 km.", "length (m)")[0], 2000)
+        self.assertEqual(point.research_value("[specialist-v3] Result: 18 km/h.", "speed (m/s)")[0], 5)
+        self.assertEqual(point.research_value("The power is 42 W.", "power (W)")[0], 42)
+        self.assertEqual(point.research_value("Result: 9.8 m/s².", "acceleration (m/s^2)")[0], 9.8)
+        self.assertEqual(point.research_value("42 m", "length (m)")[0], 42)
+        self.assertEqual(point.research_value("Result: +.5 m", "length (m)")[0], .5)
+        self.assertEqual(point.research_value("Result: 1,234 m", "length (m)")[0], 1234)
