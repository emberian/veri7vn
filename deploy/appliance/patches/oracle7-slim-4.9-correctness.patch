+"""Execute the frozen bytes of an admitted local formula, not its mutable folder.
+
+This is admission/version binding for trusted local Python, not a Python sandbox.
+Only examined files are copied. Local imports and relative file reads use that
+copy in a fresh interpreter; no module cache from another part is reused.
+"""
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+RUNNER = """import contextlib, io, json, os, runpy, sys
+directory, arguments = sys.argv[1:]
+sys.dont_write_bytecode = True
+os.chdir(directory)
+sys.path.insert(0, directory)
+with contextlib.redirect_stdout(io.StringIO()):
+    module = runpy.run_path(os.path.join(directory, 'program.py'))
+    value = module['compute'](*json.loads(arguments))
+print(json.dumps(value, allow_nan=False))
+"""
+
+
+def execute(directory, args):
+    result = subprocess.run(
+        [sys.executable, "-I", "-c", RUNNER, str(Path(directory).resolve()),
+         json.dumps(args, allow_nan=False)],
+        capture_output=True, text=True, timeout=30, check=True)
+    return json.loads(result.stdout)
+
+
+class BoundPart:
+    """A private snapshot whose bytes and signature passed the held-out gate."""
+
+    def __init__(self, directory):
+        import exam
+        directory = Path(directory)
+        self.original = directory
+        self._temp = tempfile.TemporaryDirectory(prefix="oracle7-admitted-")
+        self.path = Path(self._temp.name) / directory.name
+        self.path.mkdir()
+        try:
+            verdict = (directory / "verdict_heldout.json").read_bytes()
+            if json.loads(verdict).get("decision") != "ADMIT":
+                raise ValueError("part has no held-out admission")
+            self.verdict = verdict
+            # Match exam.files_sha's exclusions. Never expose unexamined files
+            # (including cached bytecode) to a formula's local imports.
+            for source in sorted(directory.rglob("*")):
+                relative = source.relative_to(directory)
+                if not source.is_file() or "__pycache__" in relative.parts:
+                    continue
+                if (source.name.startswith(("verdict_", "shared_verdict_", "exam_log"))
+                        or relative.parts[0] == "files"
+                        or source.name in ("credit.json", "probes.json", "registry.json")):
+                    continue
+                dest = self.path / relative
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_bytes(source.read_bytes())
+            (self.path / "verdict_heldout.json").write_bytes(verdict)
+            status = exam.status(self.path)
+            if status["state"] != "admitted":
+                raise ValueError("part is %s" % status["state"])
+            # Detect a revocation or replacement while taking the snapshot.
+            if (directory / "verdict_heldout.json").read_bytes() != verdict:
+                raise ValueError("admission changed while binding part")
+            self.digest = status["verdict"]["files_sha"]
+            self.manifest = exam.read_manifest(self.path)
+        except Exception:
+            self.close()
+            raise
+
+    def close(self):
+        self._temp.cleanup()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+    def compute(self, *args):
+        self.check_admission()
+        return execute(self.path, args)
+
+    def check_admission(self):
+        import exam
+        if ((self.original / "verdict_heldout.json").read_bytes() != self.verdict
+                or exam.status(self.path)["state"] != "admitted"):
+            raise ValueError("part admission was revoked or expired")
+
+    def export(self, destination):
+        self.check_admission()
+        destination = Path(destination)
+        if destination.exists():
+            expected = {p.relative_to(self.path): p.read_bytes() for p in self.path.rglob("*") if p.is_file()}
+            actual = {p.relative_to(destination): p.read_bytes() for p in destination.rglob("*") if p.is_file()}
+            if actual != expected:
+                raise ValueError("existing exported snapshot has changed")
+        else:
+            shutil.copytree(self.path, destination)
