+class PlannerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.specs = self.root / "specialists"
+        self.specs.mkdir()
+
+    def part(self, sid, inputs, output, source, extra=None):
+        folder = self.specs / sid
+        folder.mkdir()
+        (folder / "manifest.json").write_text(json.dumps({"id": sid}))
+        (folder / "spec.json").write_text(json.dumps({"inputs": inputs, "output": output}))
+        (folder / "program.py").write_text(source)
+        for name, content in (extra or {}).items():
+            (folder / name).write_text(content)
+        self.admit(folder)
+        return point.represent(folder)
+
+    def admit(self, folder):
+        (folder / "verdict_heldout.json").write_text(json.dumps({"decision": "ADMIT", "files_sha": exam.files_sha(folder)}))
+
+    def plan(self, want, have, parts=(), **kw):
+        return point.plan({"want": want, "have": have, **kw}, {p["id"]: p for p in parts}, self.specs, None)
+
+    def test_distinct_same_unit_is_not_a_solution(self):
+        self.assertIsNone(self.plan("width (m)", {"height (m)": 5})["result"])
+
+    def test_exact_named_input_is_a_solution(self):
+        self.assertEqual(self.plan("width (m)", {"width (m)": 5})["result"], ["width (m)", 5])
+
+    def test_repeated_units_preserve_operand_order_and_values(self):
+        part = self.part("difference", ["width (m)", "height (m)"], "difference (m)",
+                         "def compute(width, height):\n    return width - height\n")
+        self.assertEqual(self.plan("difference (m)", {"height (m)": 3, "width (m)": 8}, [part])["result"], ["difference (m)", 5])
+
+    def test_positive_chain_and_unrelated_failure(self):
+        area = self.part("area", ["width (m)", "height (m)"], "area (m^2)", "def compute(w,h): return w*h\n")
+        volume = self.part("volume", ["area (m^2)", "depth (m)"], "volume (m^3)", "def compute(a,d): return a*d\n")
+        broken = self.part("unrelated", ["width (m)"], "other (m)", "def compute(w): return 1/0\n")
+        result = self.plan("volume (m^3)", {"width (m)": 2, "height (m)": 3, "depth (m)": 4}, [broken, area, volume])
+        self.assertEqual(result["result"], ["volume (m^3)", 24])
+        self.assertEqual([s["part"] for s in result["steps"] if s["step"] == "compute"], ["area", "volume"])
+
+    def test_explicit_alias_connects_synonyms(self):
