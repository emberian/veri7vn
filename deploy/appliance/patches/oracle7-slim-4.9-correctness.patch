+"""Real w175/w480 persistence methods; controlled bases avoid loading the full chain.
+
+These tests establish state placement and isolation, not specialist answer quality.
+"""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import sys
+import tempfile
+import types
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+ADMITTED = ROOT / 'root/fable-content/oracle-m-series-2026-08-15/self_loop/admitted'
+
+
+def load_file(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class VesselStateTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name).resolve()
+        self.source_loop = self.root / 'source/self_loop'
+        self.admitted = self.source_loop / 'admitted'
+        self.admitted.mkdir(parents=True)
+        for name in ('oracle_release_runtime_w175.py', 'oracle_release_runtime_w480.py'):
+            shutil.copyfile(ADMITTED / name, self.admitted / name)
+        self.base = types.ModuleType('oracle_release_runtime_w171')
+        self.base.OracleReleaseRuntimeW171 = object
+        self.an = types.ModuleType('oracle_release_runtime_an')
+        self.an.CITE = re.compile(r'\[[^]]+\]')
+        self.an.content_terms = lambda text: set(text.split())
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def load_pair(self, state, suffix):
+        env = dict(os.environ)
+        env.pop('ORACLE7_STATE', None)
+        if state is not None:
+            env['ORACLE7_STATE'] = str(state)
+        dependencies = {'oracle_release_runtime_w171': self.base, 'oracle_release_runtime_an': self.an}
+        # No real optional organ imports or complete runtime base chain in this test.
+        dependencies.update({name: None for name in ('math_organ_v1', 'organ_dialogue_v1', 'oracle_tritree_v1')})
+        with patch.dict(os.environ, env, clear=True), patch.dict(sys.modules, dependencies):
+            w175 = load_file(self.admitted / 'oracle_release_runtime_w175.py', 'test_w175_' + suffix)
+            parent = types.ModuleType('oracle_release_runtime_w354')
+            class Base(w175.OracleReleaseRuntimeW175):
+                def _measuring(self):
+                    return False
+            parent.OracleReleaseRuntimeW354 = Base
+            with patch.dict(sys.modules, {'oracle_release_runtime_w175': w175, 'oracle_release_runtime_w354': parent}):
+                w480 = load_file(self.admitted / 'oracle_release_runtime_w480.py', 'test_w480_' + suffix)
+        return w175, w480
+
+    def test_explicit_roots_are_separate_and_legacy_default_is_preserved(self):
+        first, first_db = self.load_pair(self.root / 'workspace-a/state', 'a')
+        second, second_db = self.load_pair(self.root / 'workspace-b/state', 'b')
+        legacy, legacy_db = self.load_pair(None, 'legacy')
+        for module, db_module, expected in ((first, first_db, self.root / 'workspace-a/state/vessels'),
+                                            (second, second_db, self.root / 'workspace-b/state/vessels'),
+                                            (legacy, legacy_db, self.source_loop)):
+            self.assertEqual(module.VESSELS, expected / 'vessels.json')
+            self.assertEqual(module.EVENTS, expected / 'vessels_events.jsonl')
+            self.assertEqual(module.REQUESTS, expected / 'curriculum_requests.jsonl')
+            self.assertEqual(db_module.VESSEL_DB, expected / 'vessels.sqlite3')
+        self.assertNotEqual(first.VESSELS, second.VESSELS)
+        self.assertTrue(first.VESSELS.parent.is_dir())
+        self.assertFalse(legacy.VESSELS.exists())
+
+    def test_real_json_save_event_and_reinforcement_stay_in_each_workspace(self):
+        modules = [self.load_pair(self.root / label, label)[0] for label in ('a', 'b')]
+        for label, module in zip(('a', 'b'), modules):
+            runtime = module.OracleReleaseRuntimeW175()
+            surface = 'unknown shape ' + label
+            first, reinforced = runtime._receive(surface, 'session', {'status': 'withheld', 'path': 'test'})
+            self.assertFalse(reinforced)
+            second, reinforced = runtime._receive(surface, 'session', {'status': 'withheld', 'path': 'test'})
+            self.assertTrue(reinforced)
+            self.assertEqual(second['count'], 2)
+            store = json.loads(module.VESSELS.read_text())
+            self.assertEqual(list(store['by_key']), [surface])
+            events = [json.loads(line) for line in module.EVENTS.read_text().splitlines()]
+            self.assertEqual([e['event'] for e in events], ['open', 'reinforce'])
+            requests = [json.loads(line) for line in module.REQUESTS.read_text().splitlines()]
+            self.assertEqual(requests[0]['surface'], surface)
+        self.assertEqual(sorted(p.name for p in self.source_loop.iterdir()), ['admitted'])
+
+    def test_real_w480_database_and_reinforcement_follow_relocated_w175(self):
+        pairs = [self.load_pair(self.root / label, label) for label in ('a', 'b')]
+        for label, (w175, w480) in zip(('a', 'b'), pairs):
+            runtime = w480.OracleReleaseRuntimeW480()
+            db = runtime._c478_db()
+            try:
+                self.assertEqual(Path(db.execute('PRAGMA database_list').fetchone()[2]), w480.VESSEL_DB)
+                db.execute("INSERT INTO meta VALUES ('imported','1')")
+                db.commit()
+                surface = 'unknown indexed ' + label
+                runtime._receive(surface, 'session', {'status': 'withheld', 'path': 'test'})
+                vessel, reinforced = runtime._receive(surface, 'session', {'status': 'withheld', 'path': 'test'})
+                self.assertTrue(reinforced)
+                self.assertEqual(vessel['count'], 2)
+                self.assertEqual(db.execute('SELECT key FROM vessel').fetchall(), [(surface,)])
+                self.assertTrue(w175.EVENTS.is_file())
+                self.assertEqual(json.loads(w175.REQUESTS.read_text())['surface'], surface)
+            finally:
+                db.close()
+        self.assertEqual(sorted(p.name for p in self.source_loop.iterdir()), ['admitted'])
+
+
+if __name__ == '__main__':
+    unittest.main()
