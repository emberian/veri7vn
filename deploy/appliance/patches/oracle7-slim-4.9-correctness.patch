+        route.answer.assert_not_called()
+        mod,runtime = fold(566,565,first)
+        mod._RR3 = router()
+        self.assertIs(runtime.chat("Who invented the Engine?"),first)
+        mod._RR3.answer.assert_not_called()
+
+    def test_equal_answers_do_not_establish_unique_reading(self):
+        result,_ = self.run_composed([Organ("A",lambda q:"10"),Organ("B",lambda q:"10")])
+        self.assertEqual(result["refusal"]["reason"],"ambiguous_candidates")
+
+    def test_ignored_given_cannot_be_hidden_by_relation_fallback(self):
+        result,route = self.run_composed([Organ("A",lambda q:"42")])
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+
+    def test_constant_result_equal_to_perturbed_input_is_not_dependence(self):
+        result,route = self.run_composed([Organ("A",lambda q:"Result: 2 m.")],
+                                       question="For 1 m, what is the result?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+        result,_ = self.run_composed([Organ("A",lambda q:"Result: 2 m.")],
+                                    question="For 2 m, what is the result?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+
+    def test_missing_counterfactual_is_inconclusive(self):
+        result,route = self.run_composed([Organ("A",lambda q:"Result: 2 m." if "1 m" in q else None)],
+                                       question="For 1 m, what is the result?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+
+    def test_refused_counterfactual_is_inconclusive(self):
+        class RefusingOrgan(Organ):
+            def reply(self, text, session_id="default"):
+                if "1 m" in text:
+                    return super().reply(text,session_id)
+                return dict(id=self.id,kind="out_of_domain",status="withheld",declined=True,response="Outside domain.")
+        result,route = self.run_composed([RefusingOrgan("A",lambda q:"Result: 2 m.")],
+                                       question="For 1 m, what is the result?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+
+    def test_numeric_formatting_or_changed_unit_is_not_output_dependence(self):
+        for altered in ("Result: 2.0 m.", "Result: 3 kg."):
+            result,_ = self.run_composed([Organ("A",lambda q:"Result: 2 m." if "1 m" in q else altered)],
+                                        question="For 1 m, what is the result?")
+            self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+
+    def test_identity_computation_may_equal_each_given(self):
+        result,_ = self.run_composed([Organ("A",lambda q:"Result: %s m." % COMBO.NUM.search(q).group())],
+                                    question="For 1 m, what is the result?")
+        self.assertEqual(result["status"],"answered")
+        self.assertEqual(result["response"],"Result: 1 m. [A]")
+
+    def test_every_given_must_move_the_answer(self):
+        result,route = self.run_composed([Organ("A",lambda q:str(float(COMBO.NUM.search(q).group())*10))],
+                                       question="Calculate area for length 3 and width 4?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+
+    def test_seventh_given_is_not_silently_omitted(self):
+        def sum_first_six(question):
+            return str(sum(float(m.group()) for m in list(COMBO.NUM.finditer(question))[:6]))
+        result,route = self.run_composed([Organ("A",sum_first_six)],
+                                       question="Compute with 1, 2, 3, 4, 5, 6 and 7?")
+        self.assertEqual(result["refusal"]["reason"],"input_dependence_failed")
+        route.answer.assert_not_called()
+
+    def test_failed_candidate_validation_stands_but_unavailable_family_is_a_gap(self):
+        mod,runtime = fold(565,564,ORDINARY)
