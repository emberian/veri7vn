+"""Untrusted Python fallback policy; this does not establish answer correctness.
+
+A checked contradiction is not a missing record. Keep its receipt across later
+coverage folds; legacy paths remain supported while producers adopt receipts.
+"""
+import re
+from runtime_final_outcome import replacement_reply
+
+_TERMINAL_PATH = re.compile(
+    r"(?:^|[>|])(?:proved_check:disagree|combo:disagree|"
+    r"does_not_follow|out_of_fragment|validity|out_of_domain)(?:$|[>|])"
+)
+
+
+def terminal_refusal(reply):
+    if not isinstance(reply, dict):
+        return False
+    for key in ("kernel_check", "refusal"):
+        receipt = reply.get(key)
+        if isinstance(receipt, dict) and receipt.get("terminal") is True:
+            return True
+    return bool(_TERMINAL_PATH.search(str(reply.get("path", ""))))
+
+
+def withhold(reply, reason, response, candidates=()):
+    """Create a terminal local refusal without mutating the earlier receipt."""
+    out = replacement_reply(reply)
+    previous_path = str(reply.get("path", ""))
+    out.update(status="withheld", path="composed>" + reason, response=response,
+               refusal={"terminal": True, "reason": reason,
+                        "declined_path": previous_path,
+                        "candidates": sorted(candidates)})
+    return out
