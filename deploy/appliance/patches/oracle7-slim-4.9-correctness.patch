@@ -0,0 +1,75 @@
+"""Real Family/_Organ composition; both bundles remain independently loadable."""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+REPO = Path(__file__).resolve().parents[2]
+SPECIALISTS = REPO / 'root/specialists'
+SPEC = importlib.util.spec_from_file_location('weather_combo_under_test', SPECIALISTS / '_gate/combo_runtime_v1.py')
+COMBO = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(COMBO)
+
+
+def family(ids):
+    # Production Family and its real isolated module loader, with controlled
+    # manifest paths so another installed release cannot supply the helpers.
+    return COMBO.Family([str(SPECIALISTS / sid / 'manifest.json') for sid in ids],
+                        [str(SPECIALISTS / sid) for sid in ids])
+
+
+def scorer(sid):
+    spec = importlib.util.spec_from_file_location('weather_scorer_' + sid, SPECIALISTS / sid / 'weather_scorer.py')
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod.ok
+
+
+class WeatherCoexistence(unittest.TestCase):
+    def test_each_isolated_bundle_retains_its_own_panel(self):
+        for sid, filename, count in [('meteorology', 'weather_panel_v1.json', 98),
+                                     ('meteorology-v2', 'weather_panel_v2.json', 110)]:
+            own = family([sid])
+            score = scorer(sid)
+            panel = json.loads((SPECIALISTS / sid / filename).read_text())
+            self.assertEqual(len(panel), count)
+            for row in panel:
+                with self.subTest(sid=sid, q=row['q']):
+                    self.assertTrue(score(row, own.reply(row['q']))[0])
+
+    def test_both_loading_orders_preserve_positive_and_decline_panels(self):
+        panel = json.loads((SPECIALISTS / 'meteorology-v2/weather_panel_v2.json').read_text())
+        score = scorer('meteorology-v2')
+        for ids in [('meteorology', 'meteorology-v2'), ('meteorology-v2', 'meteorology')]:
+            both = family(ids)
+            # Same-named helpers must be private copies from each owned bundle.
+            for organ in both.organs:
+                helper = organ.mods['weather_measurements_v2']
+                self.assertEqual(Path(helper.__file__).parent, SPECIALISTS / organ.id)
+            for row in panel:
+                with self.subTest(order=ids, q=row['q']):
+                    self.assertTrue(score(row, both.reply(row['q']))[0])
+
+    def test_invalid_isa_never_recovers_a_legacy_answer(self):
+        templates = ['ISA temperature at %s altitude?',
+                     'Standard atmosphere: temperature at %s altitude?']
+        bad = ['3,000 m/s', '3,00 m', '−3,000 m', '3,000 m or 4,000 m',
+               '3,000 m with sea-level pressure 900 hPa']
+        for ids in [('meteorology', 'meteorology-v2'), ('meteorology-v2', 'meteorology')]:
+            both = family(ids)
+            for template in templates:
+                for quantity in bad:
+                    with self.subTest(order=ids, q=template % quantity):
+                        self.assertNotEqual((both.reply(template % quantity) or {}).get('status'), 'answered')
+            for question in ['ISA temperature at -1 m altitude?', 'ISA temperature at 12,000 m altitude?',
+                             'ISA temperature at an altitude?']:
+                with self.subTest(order=ids, q=question):
+                    result = both.reply(question)
+                    self.assertIsNotNone(result, 'in-domain ISA refusal was filtered by the manifest')
+                    self.assertEqual(result['status'], 'withheld')
+
+
+if __name__ == '__main__':
+    unittest.main()
