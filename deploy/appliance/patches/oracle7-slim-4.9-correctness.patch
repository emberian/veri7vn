+"""Untrusted quantity recognition for the weather reader, independent of formulas.
+
+Mask full numeric runs before role matching: invalid grouping/signs/exponents
+cannot be retried at a plausible suffix. Callers bind issued markers to roles,
+check units, and require every supplied number to be used by that one request.
+Python Fraction parses the supported decimal/scientific literals exactly; the
+published weather formulas still consume ordinary finite floats.
+"""
+from fractions import Fraction
+import math
+import re
+
+N = r"(wq[0-9]+q)"
+UNIT_END = r"(?![\w%^]|\s*(?:/|\*|\^|·|per\b))"
+TEMP = N + r"\s*(?:°\s*|degrees?\s*)?(f|c|fahrenheit|celsius)\b" + UNIT_END
+WIND = N + r"\s*(mph|km/h|kph|kmh|m/s|knots?|kt)\b" + UNIT_END
+ALTITUDE = N + r"\s*(km|m|ft|feet|meters?|metres?)\b" + UNIT_END
+RH = (N + r"\s*%\s*(?:relative )?humidity\b" + UNIT_END + r"|(?:relative )?humidity\s*(?:of|is|at|=)?\s*"
+      + N + r"\s*%?" + UNIT_END + r"(?=\s*(?:[?.,;:]|$|\b(?:and|at|with|for|find|what|calculate|compute)\b))")
+# Include malformed numeric punctuation in the candidate; only the full grammar
+# below decides validity. A slash followed by a letter remains part of a unit.
+CANDIDATE = re.compile(
+    r"(?<![\w.,+\-−/])(?:[+\-−]\s*)*(?:[0-9]|\.[0-9])[0-9.,eE+\-−_]*"
+    r"(?:\s*/\s*(?:[+\-−]\s*)*[0-9.][0-9.,eE+\-−_]*)?")
+DECIMAL = re.compile(r"[+\-]?(?:(?:[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+)(?:\.[0-9]+)?|\.[0-9]+)(?:[eE][+\-]?[0-9]+)?\Z")
+
+
+class InvalidMeasurement(ValueError):
+    pass
+
+
+def decimal(literal):
+    if not DECIMAL.fullmatch(literal):
+        raise InvalidMeasurement('malformed number')
+    # Small explicit limits prevent giant exact-integer allocation for hostile
+    # scientific literals; these are parser resource limits, not model laws.
+    if len(literal) > 128:
+        raise InvalidMeasurement('number too long')
+    exponent = re.search(r'[eE]([+\-]?[0-9]+)$', literal)
+    if exponent and abs(int(exponent.group(1))) > 300:
+        raise InvalidMeasurement('exponent too large')
+    return Fraction(literal.replace(',', ''))
+
+
+def number(literal):
+    parts = literal.replace('−', '-').split('/')
+    if len(parts) == 1:
+        q = decimal(parts[0])
+    elif len(parts) == 2:
+        denominator = decimal(parts[1].strip())
+        if denominator == 0:
+            raise InvalidMeasurement('zero denominator')
+        q = decimal(parts[0].strip()) / denominator
+    else:
+        raise InvalidMeasurement('multiple fraction slashes')
+    value = float(q)
+    if not math.isfinite(value) or (q and value == 0):
+        raise InvalidMeasurement('non-finite number')
+    return value
+
+
+class Measurements:
+    def __init__(self, text):
+        self.values, self.used = {}, set()
+        text = ' '.join(str(text or '').lower().split())
+        if any(c.isdecimal() and c not in '0123456789' for c in text):
+            raise InvalidMeasurement('unsupported digits')
+        out, pos, next_id = [], 0, 0
+        for m in CANDIDATE.finditer(text):
+            end = m.end()
+            # One sentence punctuation character is not part of the literal.
+            if text[end - 1] in '.,':
+                end -= 1
+            literal = text[m.start():end]
+            marker = 'wq%dq' % next_id
+            while marker in text or marker in self.values:
+                next_id += 1
+                marker = 'wq%dq' % next_id
+            next_id += 1
+            self.values[marker] = number(literal)
+            out.extend((text[pos:m.start()], marker))
+            pos = end
+        out.append(text[pos:])
+        self.text = ''.join(out)
+
+    def unique(self, pattern):
+        matches = list(re.finditer(pattern, self.text))
+        if len(matches) > 1:
+            raise InvalidMeasurement('ambiguous measurement')
+        return matches[0] if matches else None
