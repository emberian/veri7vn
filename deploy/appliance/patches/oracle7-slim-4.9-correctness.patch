+"""Actual final folds/transition recorder with explicit store and lower-route doubles."""
+import importlib.util
+import os
+from pathlib import Path
+import re
+import sys
+import types
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+ADMITTED = ROOT / 'root/fable-content/oracle-m-series-2026-08-15/self_loop/admitted'
+WANDER = ROOT / 'root/wander-train'
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def answer(text, path='verified:cube'):
+    return {'status': 'answered', 'response': text, 'path': path, 'provenance': {}}
+
+
+def refused(path='missing'):
+    return {'status': 'withheld', 'response': 'No record.', 'path': path}
+
+
+class LowerAM:
+    """A lower reader that eagerly stores its reply, like the real E/AM tier."""
+    def __init__(self):
+        self.dialogue = {}
+        self.calls = []
+        self.routes = {}
+
+    def chat(self, text, session_id='default'):
+        self.calls.append((text, session_id))
+        result = self.routes.get(text, refused())
+        if not isinstance(result, dict) or not str(result.get('path', '')).startswith('act:'):
+            self.dialogue[session_id] = {'last_topic': text, 'last_result': result}
+        if isinstance(result, Exception):
+            raise result
+        return dict(result)
+
+
+class FinalOutcomeTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.modules = dict(sys.modules)
+        cls.path = list(sys.path)
+        sys.path.insert(0, str(ADMITTED))
+        sys.modules['oracle_release_runtime_am'] = types.SimpleNamespace(OracleReleaseRuntimeAM=LowerAM)
+        cls.an = load('oracle_release_runtime_an', WANDER / 'oracle_release_runtime_an.py')
+        sys.modules['oracle_release_runtime_w556'] = types.SimpleNamespace(OracleReleaseRuntimeW556=cls.an.OracleReleaseRuntimeAN)
+        cls.w557 = load('oracle_release_runtime_w557', ADMITTED / 'oracle_release_runtime_w557.py')
+        cls.w558 = load('oracle_release_runtime_w558', ADMITTED / 'oracle_release_runtime_w558.py')
+        sys.modules['oracle_release_runtime_w433'] = types.SimpleNamespace(OracleReleaseRuntimeW433=cls.w558.OracleReleaseRuntimeW558)
+        cls.w568 = load('oracle_release_runtime_w568', ADMITTED / 'oracle_release_runtime_w568.py')
+        cls.w571 = load('oracle_release_runtime_w571', ADMITTED / 'oracle_release_runtime_w571.py')
+        load('oracle_release_runtime_w435', ADMITTED / 'oracle_release_runtime_w435.py')
+        cls.w436 = load('oracle_release_runtime_w436', ADMITTED / 'oracle_release_runtime_w436.py')
+
+    @classmethod
+    def tearDownClass(cls):
+        sys.path[:] = cls.path
+        for name in list(sys.modules):
+            if name not in cls.modules:
+                del sys.modules[name]
+        sys.modules.update(cls.modules)
+
+    def setUp(self):
+        self.env = patch.dict(os.environ, {'ORACLE7_V4_RECALL': '0'})
+        self.env.start()
+        self.ledger = []
+        self.w557.ledger_append = self.ledger.append
+        self.w568._RD = None
+        self.w571._P = None
+        self.runtime = self.w436.OracleReleaseRuntimeW436()
+
+    def tearDown(self):
+        self.env.stop()
+
+    def test_standalone_law_and_pronoun_folds_record_once(self):
