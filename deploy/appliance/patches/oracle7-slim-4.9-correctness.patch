+    def test_no_composed_candidate_allows_ordinary_relation_gain(self):
+        result,route = self.run_composed([])
+        self.assertEqual(result["status"],"answered")
+        route.answer.assert_called_once()
+
+
+class RealComposedFolders(unittest.TestCase):
