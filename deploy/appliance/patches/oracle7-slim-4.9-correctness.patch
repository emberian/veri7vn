+ADMITTED = ROOT / "root/fable-content/oracle-m-series-2026-08-15/self_loop/admitted"
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class OwnerTests(unittest.TestCase):
+    def setUp(self):
+        self.names = load("fixture_names", WANDER / "entity_linker_v1.py")
+        db = self.names._DB = sqlite3.connect(":memory:")
+        self.addCleanup(db.close)
+        db.execute("CREATE TABLE name (norm TEXT, qid INTEGER, links INTEGER, alias INTEGER)")
+        db.executemany("INSERT INTO name VALUES (?, ?, ?, ?)",
+                       [("example book", 101, 8, 0), ("jane smith", 1, 10, 0),
+                        ("john smith", 2, 9, 0)])
+        self.linker = SimpleNamespace(norm=self.names.norm, candidates=self.names.candidates)
+        self.router = SimpleNamespace(classes=lambda qid: {5} if qid in (1, 2) else set(),
+                                      values=Mock(return_value={2}))
+        with patch.dict(sys.modules, {"entity_linker_v3": self.linker, "reach_router_v3": self.router}):
