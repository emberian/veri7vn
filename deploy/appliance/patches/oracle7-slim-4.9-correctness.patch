@@ -0,0 +1,64 @@
+"""Narrow regression checks; does not create or alter admission evidence."""
+import json
+from pathlib import Path
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+REPO = Path(__file__).resolve().parents[2]
+SOURCE = REPO / 'root/specialists/meteorology-v2'
+sys.path.insert(0, str(SOURCE))
+from organ_weather_v2 import WeatherOrgan
+from weather_measurements_v2 import InvalidMeasurement, Measurements
+from weather_scorer import ok
+
+
+class WeatherQuantities(unittest.TestCase):
+    def setUp(self):
+        self.organ = WeatherOrgan()
+
+    def test_shipped_panel(self):
+        rows = json.loads((SOURCE / 'weather_panel_v2.json').read_text())
+        self.assertEqual(len(rows), 110)
+        for row in rows:
+            with self.subTest(split=row['split'], q=row['q']):
+                self.assertTrue(ok(row, self.organ.answer(row['q']))[0])
+
+    def test_independent_quantity_policies(self):
+        rows = json.loads(Path(__file__).with_name('quantity_cases.json').read_text())
+        for row in rows:
+            with self.subTest(name=row['name']):
+                answer = self.organ.answer(row['q']) or {}
+                if row.get('withheld'):
+                    self.assertNotEqual(answer.get('status'), 'answered')
+                else:
+                    self.assertEqual(answer.get('status'), 'answered', answer)
+                    self.assertAlmostEqual(answer['value'], row['value'], delta=row['tolerance'])
+
+    def test_full_numeric_spans_and_resources(self):
+        for text in ['3,00 m', '--3 m', '- 3 m', '3e+ m', '3/0 m', '3..0 m', '3,000,00 m', '1e301 m', '1e-300/1e300 m']:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidMeasurement):
+                    Measurements(text)
+        for text, value in [('−3,000 m', -3000), ('+.5 m', .5), ('6,000 / 2 m', 3000), ('3e3m', 3000)]:
+            with self.subTest(text=text):
+                parsed = Measurements(text)
+                self.assertEqual(list(parsed.values.values()), [value])
+
+    def test_unsupported_and_ambiguous_roles(self):
+        for question in [
+            'What is the heat index at 90 F with relative humidity 50 kg?',
+            'What is the heat index at 90 F with 50% humidity per second?',
+            'Dew point 12 C and dew point 10 C: what is relative humidity?',
+            'Dew point 10 C and dew point 12 C: what is relative humidity?',
+            'What is the heat index at 1e300 F with 50% humidity?',
+            'ISA temperature at wq0q m altitude?',
+            'ISA temperature at 3,000 m altitude and baseline --900 hPa?',
+            'What is the wind chill at 32 F with 1e-300/-1e300 mph wind?',
+        ]:
+            with self.subTest(question=question):
+                self.assertNotEqual((self.organ.answer(question) or {}).get('status'), 'answered')
+
+
+if __name__ == '__main__':
+    unittest.main()
