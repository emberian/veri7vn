+"""Untrusted final-turn bookkeeping for the runtime's known in-memory session stores.
+
+Descendant chat methods nest; only the outermost call for this instance/session
+commits the delivered reply. Context-local frames distinguish nested sessions.
+This is not a transaction over arbitrary fold attributes, files, or external effects.
+"""
+from contextvars import ContextVar
+from copy import deepcopy
+from functools import wraps
+import os
+import re
+import time
+
+_FRAMES = ContextVar("oracle_final_turns", default=())
+_CITE = re.compile(r"\[[a-z0-9_]+:?[a-z0-9_.\-]*\]")
+_ACTS = ("act:provenance_replay", "act:acknowledge", "act:continue_topic", "act:refine")
+
+
+def replacement_reply(reply):
+    """Copy envelope fields, dropping attribution and values of the replaced answer."""
+    new = dict(reply)
+    for key in ("proved", "kernel_check", "value", "kind", "reentry"):
+        new.pop(key, None)
+    return new
+
+
+def _answer(reply):
+    if not isinstance(reply, dict):
+        return None
+    return tuple(reply.get(key) for key in ("status", "response", "path"))
+
+
+def final_turn(method):
+    if getattr(method, "_oracle_final_turn", False):
+        return method
+
+    @wraps(method)
+    def wrapped(self, text, session_id="default"):
+        frames = _FRAMES.get()
+        frame = next((f for f in reversed(frames)
+                      if f["instance"] is self and f["session"] == session_id), None)
+        outer = frame is None
+        if outer:
+            frame = {"instance": self, "session": session_id,
+                     "snapshot": self._v4_snapshot(session_id),
+                     "started": time.perf_counter(), "first": None,
+                     "hits": sum(rc.hits for rc in self._v4_recall())}
