+
+def load_file(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+COMBO = load_file("test_real_combo", ROOT / "root/specialists/_gate/combo_runtime_v1.py")
+
+
+def fold(number, parent_number, reply):
+    parent = ModuleType(f"oracle_release_runtime_w{parent_number}")
+    class Base:
+        def chat(self, text, session_id="default"):
+            return reply
+    setattr(parent, f"OracleReleaseRuntimeW{parent_number}", Base)
+    # Optional runtime imports must neither search for stores nor alter loaded folds.
+    modules = {parent.__name__: parent, "oracle_release_runtime_w562": None,
+               "reach_router_v1": None, "knowledge_composer_v1": None,
+               "reach_router_v2": None, "reach_router_v3": None,
+               "oracle_release_runtime_w420": ModuleType("oracle_release_runtime_w420")}
+    modules[parent.__name__] = parent
+    with patch.dict(sys.modules, modules):
+        module = load_file(f"test_w{number}", ADMITTED / f"oracle_release_runtime_w{number}.py")
+    return module, getattr(module, f"OracleReleaseRuntimeW{number}")()
+
+
+def router():
+    answer = dict(subject_qid=42, property=61, direction="fwd", answer="Ada", route="agent", pattern="who", raw=[1])
+    return SimpleNamespace(answer=Mock(return_value=answer), label=lambda q: "Engine",
+                           _load=lambda: {"plabel": {61: "inventor"}}, AGENT=re.compile(r".*"))
+
+
+class Organ:
+    def __init__(self, sid, respond):
+        self.id, self.respond, self.ctx = sid, respond, re.compile(".*")
+
+    def reply(self, text, session_id="default"):
+        response = self.respond(text)
+        if response is None:
+            return None
+        return dict(id=self.id, response=response, kind="compute", status="answered", declined=False)
+
+
+def family(*organs):
+    # Real _ask_all and _dependence, avoiding store/module loading only.
+    fam = COMBO.Family.__new__(COMBO.Family)
+    fam.organs, fam.order = list(organs), [o.id for o in organs]
+    return fam
+
+
+ORDINARY = dict(status="withheld", path="unverified:no_record", response="No record.")
+TERMINAL = [dict(status="withheld", path="proved_check:disagree>specialist:x", response="Different answers."),
+            dict(status="withheld", path="specialist:x", response="Different answers.",
+                 kernel_check=dict(comparison="disagreement", terminal=True)),
+            dict(status="withheld", path="composed>ambiguous_candidates", response="Ambiguous.",
+                 refusal=dict(reason="ambiguous_candidates", terminal=True))]
+
+
+class TerminalGuards(unittest.TestCase):
+    def test_coverage_folds_preserve_terminal_receipts_without_calling_fallback(self):
+        for number, parent in ((564,563),(565,564),(566,565)):
+            for reply in TERMINAL:
+                with self.subTest(number=number, reply=reply):
+                    mod, runtime = fold(number, parent, reply)
+                    route = router()
+                    setattr(mod, {564:"_RR",565:"_RR2",566:"_RR3"}[number], route)
+                    mod._composed_reason = Mock(side_effect=AssertionError("must not run"))
+                    mod._family = Mock(side_effect=AssertionError("must not run"))
+                    self.assertIs(runtime.chat("Who invented the Engine?"), reply)
+                    route.answer.assert_not_called()
+
+    def test_inner_composed_and_owner_methods_preserve_contradiction(self):
+        for number, parent, methods in ((554,551,("_stars","_owner")),
+                                        (562,560,("_composed",)),(563,429,("_owner_words",))):
+            for reply in TERMINAL:
+                with self.subTest(number=number, reply=reply):
+                    mod, runtime = fold(number, parent, reply)
+                    mod._load = Mock(side_effect=AssertionError("must not run"))
+                    for method in methods:
+                        self.assertIs(getattr(runtime, method)("What is 20?", "test", reply), reply)
+                    mod._load.assert_not_called()
+
+    def test_passage_fold_preserves_terminal_receipt(self):
+        # w434's actual parent is discovered from source, avoiding giant head imports.
+        source = (ADMITTED / "oracle_release_runtime_w434.py").read_text()
+        parent = int(re.search(r"from oracle_release_runtime_w(\d+) import",source).group(1))
+        for reply in TERMINAL:
+            _, runtime = fold(434, parent, reply)
+            runtime._r434_passage = Mock(side_effect=AssertionError("must not run"))
+            self.assertIs(runtime.chat("Passage: A is B. Question: Is A B?"), reply)
+            runtime._r434_passage.assert_not_called()
+
+    def test_no_record_and_nonterminal_kernel_checks_remain_eligible(self):
+        for number, parent in ((564,563),(565,564),(566,565)):
+            reply = dict(ORDINARY, kernel_check=dict(comparison="unsupported", terminal=False),
+                         proved={"session":"old"},value="old value",kind="old kind")
+            mod, runtime = fold(number, parent, reply)
+            route = router()
+            setattr(mod, {564:"_RR",565:"_RR2",566:"_RR3"}[number], route)
+            mod._composed_reason = lambda text: None
+            mod._family = lambda: (family(),COMBO)
+            result = runtime.chat("Who invented the Engine?")
+            self.assertEqual(result["status"], "answered")
+            self.assertIn("Ada",result["response"])
+            for stale in ("proved","kernel_check","value","kind"):
+                self.assertNotIn(stale,result)
+            self.assertEqual(reply["status"], "withheld")
+
+    def test_path_tokens_are_not_substrings(self):
+        self.assertFalse(terminal_refusal(dict(ORDINARY,path="unverified:validity_record_absent")))
+        self.assertTrue(terminal_refusal(dict(ORDINARY,path="network>validity>receipt")))
+
+
+class ComposedAdmission(unittest.TestCase):
+    def run_composed(self, organs, question="Convert Celsius 20 to kelvin?", reply=ORDINARY):
+        mod, runtime = fold(565,564,reply)
+        route = router()
+        mod._RR2 = route
+        mod._family = lambda: (family(*organs),COMBO)
+        return runtime.chat(question), route
+
+    def test_unique_dependent_compute_retains_coverage(self):
+        organ = Organ("kelvin",lambda q: "Kelvin: %.2f" % (float(COMBO.NUM.search(q).group())+273.15))
+        for reply in (ORDINARY, dict(status="clarification",path="act:clarify|vessel:parse",response="I didn't fully parse that")):
+            result, route = self.run_composed([organ],reply=reply)
+            self.assertEqual(result["status"],"answered")
+            self.assertEqual(result["response"],"Kelvin: 293.15 [kelvin]")
+            self.assertEqual(result["provenance"]["dependent_givens"],1)
+            route.answer.assert_not_called()
+
+    def test_conflicting_candidates_are_order_independent_terminal_refusal(self):
+        a,b = Organ("A",lambda q:"1"), Organ("B",lambda q:"2")
+        first,route = self.run_composed([a,b])
+        second,_ = self.run_composed([b,a])
+        self.assertEqual(first,second)
+        self.assertEqual(first["status"],"withheld")
+        self.assertEqual(first["refusal"]["candidates"],["A","B"])
