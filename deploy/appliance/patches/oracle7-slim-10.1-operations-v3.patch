@@ -0,0 +1,53 @@
+"""Exercise the weather selection made by the runtime's active standing lists.
+
+Uses the production Family/_Organ loader with the weather slice of each list;
+full Engine/front-door checks belong to the separate application smoke. It does
+not treat either a historical verdict or presence of a directory as admission.
+"""
+import json
+import unittest
+
+from test_weather_coexistence import SPECIALISTS, family, scorer
+
+
+class WeatherRegistration(unittest.TestCase):
+    def test_each_active_family_selects_one_repaired_weather_owner(self):
+        panel = json.loads((SPECIALISTS / 'meteorology-v2/weather_panel_v2.json').read_text())
+        score = scorer('meteorology-v2')
+        for name in ['standing_v1.txt', 'standing_v2.txt']:
+            entries = (SPECIALISTS / '_gate' / name).read_text().split()
+            selected = [sid for entry in entries for sid in entry.split('+')
+                        if sid in ('meteorology', 'meteorology-v2')]
+            self.assertEqual(selected, ['meteorology-v2'], name)
+            owner = family(selected)
+            for row in panel:
+                with self.subTest(list=name, q=row['q']):
+                    reply = owner.reply(row['q'])
+                    self.assertTrue(score(row, reply)[0])
+                    if reply:
+                        self.assertEqual(reply['provenance']['specialist'], 'meteorology-v2')
+            for question in ['ISA temperature at 3,000 m/s altitude?',
+                             'Standard atmosphere: temperature at 3,00 m altitude?',
+                             'ISA temperature at −3,000 m altitude?',
+                             'What Beaufort force is a -5 mph wind?',
+                             'Dew point 10 C and dew point 12 C: what is relative humidity?']:
+                with self.subTest(list=name, q=question):
+                    self.assertNotEqual((owner.reply(question) or {}).get('status'), 'answered')
+
+    def test_network_byte_identity_and_legacy_bundle_remain_available(self):
+        # The network's byte IDs bind learned plans: do not shift or duplicate
+        # those entries merely to select a newer direct weather-family reader.
+        for name in ['standing_net_v1.txt', 'standing_net_v6.txt']:
+            ids = [sid for entry in (SPECIALISTS / '_gate' / name).read_text().split()
+                   for sid in entry.split('+')]
+            self.assertEqual(ids.count('meteorology'), 1)
+            self.assertNotIn('meteorology-v2', ids)
+        legacy = family(['meteorology'])
+        answer = legacy.reply('ISA temperature at 3,000 m altitude?')
+        self.assertEqual(answer['status'], 'answered')
+        self.assertIn('is -4.5', answer['response'])
+        self.assertNotEqual((legacy.reply('ISA temperature at 3,000 m/s altitude?') or {}).get('status'), 'answered')
+
+
+if __name__ == '__main__':
+    unittest.main()
