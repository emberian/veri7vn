+# A whole request for the last recorded question/utterance, not a substring in
+# a compound private-state request. First-question/history-list semantics are
+# deliberately outside this exception: the dialogue organ selects the last turn.
+LAST_TURN = re.compile(r"\s*(?:what\s+did\s+i\s+(?:(?:just|last)\s+)?(?:ask|say)(?:\s+you)?|"
+                       r"what\s+was\s+my\s+(?:last|previous)\s+question)\s*[?.!]*\s*", re.I)
+
+
+def recorded_history_reply(q, out, expected):
+    """An exact match to a same-session reply captured before the parent ran.
+
+    Path/citation strings alone are not authority. The caller obtains expected
+    from the dialogue organ's pure read of its current, bounded session history.
+    This Python check does not prove the authenticity of that in-memory history.
+    """
+    if not LAST_TURN.fullmatch(q) or not isinstance(expected, dict):
+        return False
+    if expected.get("kind") != "discourse:asked_last":
+        return False
+    turns = expected.get("turns") or []
+    provenance = out.get("provenance")
+    references = [{"id": "session:turn %d" % turn, "text": "this conversation, turn %d" % turn,
+                   "role": "discourse"} for turn in turns]
+    return (out.get("path") == "organ:dialogue>discourse:asked_last"
+            and out.get("response") == expected.get("response")
+            and out.get("references") == references
+            and isinstance(provenance, dict)
+            and provenance.get("kind") == "organ_dialogue"
+            and provenance.get("move") == expected["kind"]
+            and provenance.get("turns") == turns)
+
