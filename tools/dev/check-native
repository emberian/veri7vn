#!/usr/bin/env python3
"""Check native sessions with serialized builds, isolated state and stable receipts."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import signal
import sqlite3
import shutil
import uuid
import subprocess
import sys
import time
from fixture_exports import export_data

ROOT = Path(__file__).resolve().parents[2]
EXPECTED = (
    "contract_transport", "hidden_hypothesis_exposed",
    "exported_premise_exposed", "full_statement_preserved",
    "descriptor_exports_resolved", "unresolved_export_rejected", "wrong_kind_rejected",
)


def assertion_exports(directory):
    """Read only explicit native assertion exports, never arbitrary exports."""
    texts, inventory = [], {}
    for path in sorted(directory.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(directory)
        if len(relative.parts) != 4 or relative.parts[1:3] != ("veri7vn", "assertions"):
            raise RuntimeError(f"Unexpected assertion export path: {relative}")
        if path.is_symlink() or path.stat().st_size > 65536:
            raise RuntimeError(f"Invalid assertion export: {relative}")
        body = path.read_bytes()
        texts.append(body.decode("utf-8"))
        inventory[str(relative)] = hashlib.sha256(body).hexdigest()
    return "\n".join(texts), inventory


def process_inventory():
    """Kernel identities only: never collect process arguments or environment."""
    try:
        result = subprocess.run(["ps", "-axo", "pid=,ppid=,pgid=,stat=,lstart="],
                                text=True, capture_output=True, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError) as failure:
        detail = (failure.stderr.strip() if isinstance(failure, subprocess.CalledProcessError)
                  and failure.stderr else str(failure))
        raise RuntimeError(f"Kernel process inspection unavailable: {detail}") from failure
    records = {}
    for line in result.stdout.splitlines():
        fields = line.split(None, 4)
        if len(fields) == 5:
            pid, parent, group, state, started = fields
            records[int(pid)] = {"pid": int(pid), "parent": int(parent),
                                 "group": int(group), "started": started,
                                 "state": state}
    return records


class OwnedProcesses:
    """Follow this command's descendants, including new process sessions."""
    def __init__(self, pid, root_alive=None):
        self.root = pid
        self.owned = {}
        self.sample()
        if not self.owned and root_alive is not None and root_alive():
            raise RuntimeError("Live command missing from kernel process inventory")

    def sample(self):
        current = process_inventory()
        parents = {pid for pid, old in self.owned.items()
                   if pid in current and current[pid]["started"] == old["started"]}
        if not self.owned and self.root in current:
            self.owned[self.root] = current[self.root]
            parents.add(self.root)
        while True:
            children = {pid for pid, record in current.items()
                        if record["parent"] in parents and pid not in parents}
            if not children:
                break
            for pid in children:
                self.owned[pid] = current[pid]
            parents.update(children)
        return current

    def cleanup(self):
        self.sample()
        signalled = []
        for sig in (signal.SIGTERM, signal.SIGKILL):
            current = self.sample()
            live = {pid: current[pid] for pid, record in self.owned.items()
                    if pid in current and current[pid]["started"] == record["started"]
                    and not current[pid]["state"].startswith("Z")}
            # A verified owned group leader authorizes only that command's group;
            # individual signals cover descendants that joined another group.
            groups = {record["group"] for pid, record in live.items()
                      if record["group"] in live
                      and live[record["group"]]["group"] == record["group"]}
            for group in groups:
                try:
                    os.killpg(group, sig)
                    signalled.append({"group": group, "signal": sig.name})
                except ProcessLookupError:
                    pass
            for pid, record in live.items():
                if record["group"] not in groups:
                    try:
                        os.kill(pid, sig)
                        signalled.append({"pid": pid, "signal": sig.name})
                    except ProcessLookupError:
                        pass
            deadline = time.monotonic() + 2
            while live and time.monotonic() < deadline:
                time.sleep(0.1)
                current = self.sample()
                live = {pid: current[pid] for pid, record in self.owned.items()
                        if pid in current and current[pid]["started"] == record["started"]
                        and not current[pid]["state"].startswith("Z")}
            if not live:
                break
        return {"observed": list(self.owned.values()), "signalled": signalled,
                "survivors": sorted(live), "status": "clean" if not live else "survivors"}


def default_inputs():
    # Current Core imports Main and loads inspection.ML; scaffold imports Core.
    # Adding nested imports/data requires extending this closure or --input.
    return ([ROOT / "src/isabelle/ROOT", ROOT / "tests/scaffold"] +
            sorted((ROOT / "src/isabelle").glob("*.thy")) +
            sorted((ROOT / "src/isabelle").glob("*.ML")) +
            [Path(__file__).resolve().with_name("fixture_exports.py")])


def source_snapshot(inputs=None):
    sources = {Path(__file__).resolve()}
    for path in default_inputs() if inputs is None else inputs:
        if not path.exists():
            raise ValueError(f"Missing scoped input: {path}")
        sources.update(path.rglob("*") if path.is_dir() else [path])
    return {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in sorted(sources) if p.is_file()}


def explicit_snapshot_inputs(roots, declared, extras=()):
    """Caller-declared complete loaded/auxiliary closure; roots remain navigable."""
    if not declared:
        raise ValueError("Explicit snapshot requires a nonempty complete source closure")
    navigation = [path / "ROOT" for path in roots]
    navigation += [path / "ROOTS" for path in roots if (path / "ROOTS").is_file()]
    return list(dict.fromkeys([*navigation, *declared, *extras]))


def archive_receipt(state):
    """Preserve a terminal attempt and its logs before latest paths are reused."""
    path = state / "receipt.json"
    if not path.is_file():
        return None
    previous = json.loads(path.read_text())
    key = previous.get("attempt_id") or hashlib.sha256(path.read_bytes()).hexdigest()[:24]
    destination = state / "attempts" / key
    archived = destination / "receipt.json"
    if archived.is_file():
        return archived
    destination.mkdir(parents=True, exist_ok=True)
    for command in previous.get("commands", []):
        original = (ROOT / command["log"]).resolve()
        if not original.is_relative_to(state.resolve()):
            raise ValueError(f"log outside receipt state: {original}")
        if original.is_file():
            copied = destination / original.name
            shutil.copy2(original, copied)
            command["log"] = str(copied.relative_to(ROOT))
    for selected, log in previous.get("session_logs", {}).items():
        copied = destination / Path(log).name
        if copied.is_file():
            previous["session_logs"][selected] = str(copied.relative_to(ROOT))
    bridge = previous.get("fixture_bridge")
    if bridge:
        original = ROOT / bridge["generated_data"]
        if original.is_file() and hashlib.sha256(original.read_bytes()).hexdigest() == bridge["generated_sha256"]:
            copied = destination / original.name
            shutil.copy2(original, copied)
            bridge["archived_generated_data"] = str(copied.relative_to(ROOT))
    previous["archive_receipt"] = str(archived.relative_to(ROOT))
    temporary = destination / "receipt.json.tmp"
    temporary.write_text(json.dumps(previous, indent=2) + "\n")
    temporary.replace(archived)
    return archived


def build_slot_paths(state):
    """The build lock is a small semaphore: slot 0 is build.lock, further slots build.lock.N."""
    slots = max(1, int(os.environ.get("VERI7VN_BUILD_SLOTS", "3")))
    return [state / "build.lock"] + [state / f"build.lock.{i}" for i in range(1, slots)]


def acquire_build_slot(state, no_wait):
    """Take any free slot without blocking; otherwise block on one slot (pid-chosen) unless no_wait."""
    paths = build_slot_paths(state)
    for path in paths:
        handle = path.open("a")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            handle.close()
    if no_wait:
        return None
    print(f"All {len(paths)} native build slots are held; waiting for one (use --no-wait to exit instead).",
          flush=True)
    waited = time.monotonic()
    handle = paths[os.getpid() % len(paths)].open("a")
    fcntl.flock(handle, fcntl.LOCK_EX)
    print(f"Native build slot acquired after {time.monotonic() - waited:.0f}s.", flush=True)
    return handle


def show_status():
    state = ROOT / "var/native-scaffold"
    if not (state / "build.lock").exists():
        print("Native build lock: idle (no lock file)")
        return 0
    paths = build_slot_paths(state)
    taken = 0
    for path in paths:
        with path.open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                taken += 1
    held = taken > 0
    print(f"Native build lock: {'held' if held else 'idle'} ({taken} of {len(paths)} slots taken)")
    try:
        active = json.loads((state / "active.json").read_text())
        path = Path(active["receipt"])
        if not path.resolve().is_relative_to(state.resolve()):
            raise ValueError("invalid receipt path")
        receipt = json.loads(path.read_text())
        print(f"{'Active' if held else 'Last'} driver PID: {active['driver_pid']}; receipt: {path}")
        print(f"Receipt status: {receipt['status']}; sessions: {receipt.get('sessions', [receipt['session']])}")
        print(f"Scope: {receipt.get('scope', 'unspecified')}; snapshot: {receipt.get('snapshot_mode', 'conservative')}")
        if receipt["commands"]:
            command = receipt["commands"][-1]
            print(f"Last command: {command['argv']}; child PID: {command.get('pid', 'not started')}")
            log = (ROOT / command["log"]).resolve()
            if not log.is_relative_to(state.resolve()):
                raise ValueError("invalid log path")
            if log.is_file():
                # Read only the tail; large logs must not burden status checks.
                with log.open("rb") as stream:
                    stream.seek(max(0, log.stat().st_size - 5000))
                    print(stream.read().decode("utf-8", errors="replace"))
    except (OSError, ValueError, KeyError, TypeError) as failure:
        print(f"Latest receipt not yet available: {failure}")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--isabelle", default=os.environ.get(
        "VERI7VN_ISABELLE", "/Applications/Isabelle2026-RC1.app/bin/isabelle"),
        help="Isabelle executable (default: installed RC1; or VERI7VN_ISABELLE)")
    parser.add_argument("--timeout", type=int, default=600,
                        help="maximum seconds per tool invocation (default: 600)")
    parser.add_argument("--no-wait", action="store_true",
                        help="exit with status 2 if another check holds the build lock instead of waiting")
    parser.add_argument("--session", help="lane-local session (default: scaffold)")
    parser.add_argument("--also-session", action="append", default=[],
                        help="additional selected session, repeat (maximum eight targets total)")
    parser.add_argument("--session-root", action="append", default=[],
                        help="session ROOT directory, repeat for dependencies")
    parser.add_argument("--input", action="append", default=[],
                        help="scoped input file/tree, repeat to cover dependency sources")
    parser.add_argument("--snapshot-manifest", help="Opt-in JSON complete loaded/auxiliary source closure (replaces recursive root snapshots)")
    parser.add_argument("--declare-full-source-closure", action="store_true",
                        help="Declare the manifest plus --input covers every transitive source and auxiliary input")
    parser.add_argument("--expect", action="append", default=[],
                        help="literal required build-log marker, repeat as needed")
    parser.add_argument("--scala-script", action="append", help="One Scala script run after scoped session build under the same lock")
    parser.add_argument("--diagnostic-theory", help="Saved theory ML environment used for historical diagnostic")
    parser.add_argument("--saved-image-diagnostic", help="Run ML file in an existing named heap without building current sources (historical diagnostic only)")
    parser.add_argument("--status", action="store_true", help="show shared lock state and latest command log tail")
    args = parser.parse_args()
    if args.scala_script and len(args.scala_script) != 1:
        parser.error("--scala-script may be specified only once; use a sequential wrapper for multiple scripts")
    args.scala_script = args.scala_script[0] if args.scala_script else None
    if args.status:
        return show_status()
    if not args.session and (args.session_root or args.expect or args.scala_script or args.also_session):
        parser.error("scoped options require --session")
    if args.session and not args.session_root:
        parser.error("--session requires --session-root")
    targets = ([args.session] if args.session else []) + args.also_session
    if len(targets) > 8:
        parser.error("at most eight selected sessions are supported")
    if len(targets) != len(set(targets)):
        parser.error("selected sessions must be distinct")
    def local_path(value):
        path = (ROOT / value).resolve()
        if not path.is_relative_to(ROOT):
            parser.error("scoped paths must be inside the checkout")
        if not path.exists():
            parser.error(f"missing scoped path: {value}")
        return path
    roots = [local_path(value) for value in args.session_root]
    for path in roots:
        if not (path / "ROOT").is_file():
            parser.error(f"session directory has no ROOT: {path}")
    scala_script = local_path(args.scala_script) if args.scala_script else None
    diagnostic = local_path(args.saved_image_diagnostic) if args.saved_image_diagnostic else None
    if diagnostic and (not args.diagnostic_theory or not args.session or args.also_session or scala_script or args.expect):
        parser.error("saved-image diagnostic requires one named session and no build/assertion/Scala targets")
    extras = [local_path(value) for value in args.input]
    snapshot_mode = "conservative"
    if args.snapshot_manifest:
        if not args.session or not args.declare_full_source_closure:
            parser.error("--snapshot-manifest requires --session and --declare-full-source-closure")
        manifest_path = local_path(args.snapshot_manifest)
        manifest = json.loads(manifest_path.read_text())
        if manifest.get("format") != "veri7vn.native-source-closure/1" or manifest.get("sessions") != targets:
            parser.error("snapshot manifest format/selected sessions mismatch")
        if manifest.get("session_roots") != [str(p.relative_to(ROOT)) for p in roots]:
            parser.error("snapshot manifest session roots mismatch")
        controls = manifest.get("inventory_controls_sha256", {})
        if not controls or any(hashlib.sha256(local_path(p).read_bytes()).hexdigest() != digest
                               for p, digest in controls.items()):
            parser.error("snapshot inventory ROOT/theory controls changed; regenerate and review current closure")
        inputs = explicit_snapshot_inputs(roots, [local_path(p) for p in manifest["inputs"]],
                                          [manifest_path, *extras])
        snapshot_mode = "declared_complete_closure"
    else:
        if args.declare_full_source_closure:
            parser.error("--declare-full-source-closure requires --snapshot-manifest")
        inputs = (roots if args.session else default_inputs()) + extras
    if args.timeout < 1:
        parser.error("--timeout must be positive")
    if scala_script:
        inputs.append(scala_script)
    if diagnostic:
        inputs = explicit_snapshot_inputs(roots, [diagnostic], extras)
        snapshot_mode = "historical_saved_image_diagnostic"
    executable = Path(args.isabelle).expanduser().resolve()
    state = ROOT / "var/native-scaffold"
    state.mkdir(parents=True, exist_ok=True)
    # All invocations in this checkout share a lock, including executable overrides.
    slot = acquire_build_slot(state, args.no_wait)
    if slot is None:
        parser.exit(2, "Every native build slot under var/native-scaffold is held.\n")
    with slot as lock:
        output = state
        if args.session:
            key = hashlib.sha256("\0".join(targets).encode()).hexdigest()[:16]
            output = state / "sessions" / key
            output.mkdir(parents=True, exist_ok=True)
        (state / "active.json").write_text(json.dumps({
            "driver_pid": os.getpid(), "receipt": str(output / "receipt.json")}) + "\n")
        return check(executable, output, args.timeout, args.session, roots, inputs, args.expect, scala_script, args.also_session, snapshot_mode, diagnostic, args.diagnostic_theory)


def check(executable, state, timeout, session=None, roots=(), inputs=None, expected=(), scala_script=None, also_sessions=(), snapshot_mode="conservative", diagnostic=None, diagnostic_theory=None):
    env = os.environ.copy()
    # Isabelle's supported state-root override; HOME is left untouched.
    env["USER_HOME"] = str(ROOT / "var/native-scaffold/user-state")
    archive_receipt(state)
    attempt_id = uuid.uuid4().hex
    targets = [session or "Veri7vn_Scaffold_Tests", *also_sessions]
    receipt = {
        "format": "veri7vn.native-scaffold-receipt/0",
        "attempt_id": attempt_id,
        "archive_receipt": str((state / "attempts" / attempt_id / "receipt.json").relative_to(ROOT)),
        "status": "running", "driver_pid": os.getpid(),
        "scope": ("historical saved-image ML diagnostic; NOT current source build or admission"
                  if diagnostic else "native integration smoke; not admission"),
        "started_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "executable": str(executable), "user_home": env["USER_HOME"],
        "host": {"system": platform.system(), "machine": platform.machine()},
        "resources": {"build_jobs": 1, "threads": 2, "command_timeout_seconds": timeout},
        "snapshot_mode": snapshot_mode,
        "sources_sha256": source_snapshot(inputs),
        "session": targets[0], "sessions": targets,
        "session_roots": [str(p.relative_to(ROOT)) for p in roots],
        "expected_markers": list(expected), "session_logs": {},
        "commands": [], "checks": [],
    }
    receipt_path = state / "receipt.json"

    def save():
        temporary = state / "receipt.json.tmp"
        temporary.write_text(json.dumps(receipt, indent=2) + "\n")
        temporary.replace(receipt_path)

    def run(arguments, log_name):
        command = [str(executable), *arguments]
        entry = {"argv": command, "log": str((state / log_name).relative_to(ROOT))}
        receipt["commands"].append(entry)
        save()
        begin = time.monotonic()
        # A regular file gives observers incremental output without buffering a
        # whole build behind communicate(). Child-side buffering still applies.
        with (state / log_name).open("w") as log:
            process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=log,
                                       stderr=subprocess.STDOUT, text=True, start_new_session=True)
            entry.update(pid=process.pid, status="running")
            save()
            try:
                tracker = OwnedProcesses(process.pid, lambda: process.poll() is None)
            except RuntimeError as failure:
                # Do not start an unobservable build. The Popen identity still
                # owns this original session even when process inspection fails.
                if process.poll() is None:
                    os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                entry["process_cleanup"] = {"status": "tracking_unavailable",
                                            "failure": str(failure)}
                raise RuntimeError("Cannot track owned command processes") from failure
            print(f"Running {arguments[0]}; live log: {state / log_name}", flush=True)
            try:
                deadline = begin + timeout
                while True:
                    tracker.sample()
                    if len(entry.get("owned_processes", [])) != len(tracker.owned):
                        entry["owned_processes"] = list(tracker.owned.values())
                        save()
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise subprocess.TimeoutExpired(command, timeout)
                    try:
                        process.wait(timeout=min(0.1, remaining))
                        break
                    except subprocess.TimeoutExpired:
                        continue
            except (subprocess.TimeoutExpired, KeyboardInterrupt, RuntimeError) as failure:
                try:
                    entry["process_cleanup"] = tracker.cleanup()
                except RuntimeError as inspection_failure:
                    # Never guess identities when inspection is unavailable.
                    # The still-live Popen root alone remains ours to signal.
                    if process.poll() is None:
                        os.killpg(process.pid, signal.SIGKILL)
                    entry["process_cleanup"] = {
                        "status": "inspection_failed", "failure": str(inspection_failure),
                        "observed": list(tracker.owned.values()),
                        "survivors": "unknown; inspection failed"}
                process.wait(timeout=5)
                entry.update(returncode=process.returncode, seconds=time.monotonic() - begin,
                             status="interrupted", interrupted=type(failure).__name__,
                             interruption_detail=str(failure))
                raise RuntimeError(f"{arguments[0]} interrupted: {failure}") from failure
            entry["process_cleanup"] = tracker.cleanup()
            if entry["process_cleanup"]["survivors"]:
                raise RuntimeError(f"Owned processes survived cleanup: {entry['process_cleanup']['survivors']}")
        output = (state / log_name).read_text(errors="replace")
        entry.update(returncode=process.returncode, seconds=time.monotonic() - begin,
                     status="finished")
        if process.returncode:
            raise RuntimeError(f"{arguments[0]} failed ({process.returncode}); see {entry['log']}\n{output[-5000:]}")
        return output

    start = time.monotonic()
    save()
    try:
        if not executable.is_file():
            raise RuntimeError(f"Isabelle executable not found: {executable}")
        if session is None:
            descriptor = ROOT / "tests/scaffold/package.json"
            generated = state / "fixture_exports.ML"
            generated_text = export_data(descriptor.read_bytes())
            if not generated.exists() or generated.read_text() != generated_text:
                generated.write_text(generated_text)
            receipt["fixture_bridge"] = {
                "descriptor": str(descriptor.relative_to(ROOT)),
                "generated_data": str(generated.relative_to(ROOT)),
                "generated_sha256": hashlib.sha256(generated.read_bytes()).hexdigest(),
            }
        receipt["isabelle_version"] = run(["version"], "version.log").strip()
        receipt["isabelle_settings"] = run(
            ["getenv", "ISABELLE_IDENTIFIER", "ML_SYSTEM", "ML_PLATFORM", "ISABELLE_HOME_USER"],
            "settings.log").strip()
        target = session or "Veri7vn_Scaffold_Tests"
        print(f"{'Diagnosing saved image' if diagnostic else 'Building'} {', '.join(targets)} with {receipt['isabelle_version']} (one job, two threads).", flush=True)
        directories = [str(p.relative_to(ROOT)) for p in roots] if session else ["src/isabelle", "tests/scaffold"]
        directory_args = [arg for directory in directories for arg in ("-d", directory)]
        if diagnostic:
            databases = list(Path(env["USER_HOME"]).rglob(target + ".db"))
            if len(databases) != 1:
                raise RuntimeError("Expected one saved diagnostic session database")
            database = databases[0]
            heap = database.parent.parent / target
            with sqlite3.connect(database.as_uri() + "?mode=ro", uri=True) as connection:
                row = connection.execute("SELECT return_code,uuid,sources FROM isabelle_session_info WHERE session_name=?", (target,)).fetchone()
            if row is None or row[0] != 0 or not heap.is_file():
                raise RuntimeError("Diagnostic requires a successful saved heap/database")
            saved_paths = [heap, database]
            hashes = {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in saved_paths}
            receipt["scope"] = "historical saved-image ML diagnostic; NOT current source build or admission"
            receipt["saved_image"] = {"sha256": hashes, "build_uuid": row[1],
                "loaded_source_inventory_sha256": hashlib.sha256(row[2].encode()).hexdigest()}
            # Theory-local ML structures are not the raw process namespace.
            # Enter the already-loaded theory environment, without use_thy.
            bootstrap = state / "diagnostic-bootstrap.ML"
            bootstrap.write_text("Context.put_generic_context (SOME (Context.Theory (Build.get_theory " +
                json.dumps(diagnostic_theory) + ")));\nML_Context.eval_file ML_Compiler.flags (Path.explode " +
                json.dumps(str(diagnostic)) + ");\n")
            receipt["saved_image"]["theory"] = diagnostic_theory
            receipt["saved_image"]["bootstrap_sha256"] = hashlib.sha256(bootstrap.read_bytes()).hexdigest()
            observations = run(["ML_process", "-l", target, *directory_args,
                "-o", "threads=2", "-f", str(bootstrap)], "diagnostic.log")
            if any(hashlib.sha256(p.read_bytes()).hexdigest() != hashes[str(p.relative_to(ROOT))] for p in saved_paths):
                raise RuntimeError("Saved diagnostic heap/database changed during use")
            receipt["checks"] = ["historical ML diagnostic exited successfully"]
        else:
            build = run(["build", "-v", "-b", *directory_args,
                         "-j", "1", "-o", "threads=2", *targets], "build.log")
            print(build[-5000:].strip(), flush=True)
            markers = list(expected) if session else [f"VERI7VN_SMOKE {name} PASS" for name in EXPECTED]
            logs = {}
            if markers or len(targets) > 1:
                for index, selected in enumerate(targets):
                    name = "smoke.log" if len(targets) == 1 else f"smoke-{index}.log"
                    receipt["session_logs"][selected] = str((state / name).relative_to(ROOT))
                    logs[selected] = run(["build_log", "-v", selected], name)
            # RC1 may omit successful PIDE snapshots. Explicit exports are
            # produced by fixture ML only after its native assertions finish.
            if markers and any(not any(marker in output for output in logs.values())
                               for marker in markers):
                receipt["native_assertion_exports"] = {}
                for index, selected in enumerate(targets):
                    destination = state / ("assertion-exports-" + receipt["attempt_id"]) / str(index)
                    run(["export", "-n", *directory_args, "-O", str(destination),
                         "-x", "*:veri7vn/assertions/*", selected], f"assertions-{index}.log")
                    text, inventory = assertion_exports(destination)
                    receipt["native_assertion_exports"][selected] = inventory
                    logs[selected] += "\n" + text
            observations = "\n".join(logs.values())
            receipt["marker_sessions"] = {
                marker: [selected for selected, output in logs.items() if marker in output]
                for marker in markers}
            missing = [marker for marker in markers if not receipt["marker_sessions"][marker]]
            if missing:
                raise RuntimeError(f"Missing integration assertions in build log: {missing}")
            if scala_script:
                run(["scala", str(scala_script)], "scala.log")
            receipt["checks"] = markers if session else list(EXPECTED)
        receipt["status"] = "passed"
        print(observations[-5000:].strip(), flush=True)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as failure:
        receipt["status"] = "failed"
        receipt["failure"] = str(failure)
        print(str(failure), file=sys.stderr)
    finally:
        # Agents can edit shared inputs without taking the build lock. A
        # successful tool exit must not certify a mixture of source generations.
        try:
            after = source_snapshot(inputs)
            receipt["sources_sha256_after"] = after
            stable = after == receipt["sources_sha256"]
            bridge = receipt.get("fixture_bridge")
            if bridge:
                generated_after = hashlib.sha256(
                    (ROOT / bridge["generated_data"]).read_bytes()).hexdigest()
                bridge["generated_sha256_after"] = generated_after
                stable = stable and generated_after == bridge["generated_sha256"]
            receipt["inputs_stable"] = stable
        except (OSError, ValueError) as failure:
            receipt["inputs_stable"] = False
            receipt["stability_error"] = str(failure)
        if not receipt["inputs_stable"]:
            receipt["status"] = "unstable"
            receipt["failure"] = "Inputs changed during the check; rerun after edits settle."
            print(receipt["failure"], file=sys.stderr)
        receipt["elapsed_seconds"] = time.monotonic() - start
        save()
        archived = archive_receipt(state)
        print(f"Receipt: {receipt_path}", flush=True)
        print(f"Immutable attempt: {archived}", flush=True)
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    sys.exit(main())
