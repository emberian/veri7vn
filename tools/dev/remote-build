#!/usr/bin/env python3
"""Build remotely with isolated shared caches, bounded jobs and immutable receipts."""
import argparse
import fcntl
import hashlib
import json
import os
import random
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import time
import uuid


def run(args, **kw):
    return subprocess.run(args, check=True, **kw)


def transport(host, command, **kw):
    # Serialize short connections across local lanes/worktrees, not remote builds.
    # This avoids sshd's unauthenticated-connection limit during a swarm launch.
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True)
    base = Path(common.stdout.strip()).parent if common.returncode == 0 else Path.cwd()
    locks = base / "var/remote-transport"
    locks.mkdir(parents=True, exist_ok=True)
    for retry in range(5):
        try:
            with (locks / (host + ".lock")).open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                return run(command, **kw)
        except subprocess.CalledProcessError as exc:
            if exc.returncode not in (12, 255) or retry == 4:
                raise
            time.sleep(min(8, 2 ** retry) + random.random())


def ssh(host, command, **kw):
    return transport(host, ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", host, command], **kw)


def hashes(root):
    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
            for top in ("src", "tests") for p in sorted((root / top).rglob("*"))
            if p.is_file() and "__pycache__" not in p.parts and p.suffix != ".pyc"}


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("host", choices=("hbox", "persvati"))
    ap.add_argument("session_dir")
    ap.add_argument("session")
    ap.add_argument("-d", dest="extra", action="append", default=[])
    ap.add_argument("--expect", default="")
    ap.add_argument("--check-only", action="store_true", help="isolated proof diagnostics; no usable export receipt or publication")
    ap.add_argument("--no-exports", action="store_true", help="proof-only session; check build/marker without publishing code")
    ap.add_argument("--timeout", type=int, default=1800)
    ap.add_argument("--queue-timeout", type=int, default=7200)
    ap.add_argument("--recover", metavar="ATTEMPT", help="collect an existing attempt without submitting another build")
    args = ap.parse_args()
    if args.check_only:
        args.no_exports = True
    root = Path.cwd().resolve()
    for directory in [args.session_dir, *args.extra]:
        path = Path(directory)
        if (path.is_absolute() or ".." in path.parts or not path.parts or
                path.parts[0] not in ("src", "tests") or not (root / path / "ROOT").is_file()):
            ap.error("session roots must be under the snapshotted src/ or tests/ directories and contain ROOT; use a staged checkout for scratch sessions")
    if not 30 <= args.timeout <= 7200 or not 1 <= args.queue_timeout <= 14400:
        ap.error("build timeout must be 30..7200s; queue timeout 1..14400s")
    if args.recover and (Path(args.recover).name != args.recover or not args.recover.startswith("20")):
        ap.error("--recover takes the printed attempt ID, not a path")
    attempt_id = args.recover or time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:12]
    out = root / "var" / Path(args.session_dir).name
    attempt = out / "remote-attempts" / attempt_id
    if not args.recover:
        attempt.mkdir(parents=True)
    receipt = vars(args) | {"attempt": attempt_id, "status": "preparing", "started": time.time(),
                           "checkout": str(root), "exports_published": False,
                           "driver_sha256": hashlib.sha256(Path(__file__).resolve().read_bytes()).hexdigest(),
                           "worker_sha256": hashlib.sha256(Path(__file__).resolve().with_name("remote_build_worker.py").read_bytes()).hexdigest()}
    receipt_path = attempt / "receipt.json"
    if args.recover:
        receipt = json.loads(receipt_path.read_text())
        if receipt["host"] != args.host or receipt["session"] != args.session:
            ap.error("recovery host/session differs from the saved receipt")
        receipt.setdefault("recoveries", []).append({"time": time.time(), "prior_status": receipt["status"]})
        receipt.pop("error", None)
    def save():
        temporary = receipt_path.with_suffix(".tmp")
        temporary.write_text(json.dumps(receipt, indent=2) + "\n")
        os.replace(temporary, receipt_path)
    save()
    remote = "veri7vn-builds/managed/attempts/" + attempt_id
    qremote = shlex.quote(remote)
    started = bool(args.recover)
    result = 1
    try:
        if not args.recover:
            # This immutable snapshot also makes concurrent edits in the checkout harmless.
            for snapshot_try in range(5):
                before = hashes(root)
                for top in ("src", "tests"):
                    copied = attempt / top
                    if copied.exists():
                        shutil.rmtree(copied)  # Only this attempt's unfinished copy.
                    shutil.copytree(root / top, copied, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
                snapshot = hashes(attempt)
                if snapshot == before and hashes(root) == before:
                    break
                time.sleep(0.2)
            else:
                raise RuntimeError("sources changed during all five snapshot attempts; retry after the edits settle")
            receipt["snapshot_attempts"] = snapshot_try + 1
            (attempt / "source-sha256.json").write_text(json.dumps(snapshot, indent=2) + "\n")
            receipt["source_digest"] = hashlib.sha256(json.dumps(snapshot, sort_keys=True).encode()).hexdigest()
            shutil.copy2(Path(__file__).resolve().with_name("remote_build_worker.py"), attempt / "worker.py")
            config = vars(args) | {"attempt": attempt_id, "source_digest": receipt["source_digest"]}
            (attempt / "config.json").write_text(json.dumps(config))
            ssh(args.host, "mkdir -p " + qremote)
            transport(args.host, ["rsync", "-a", str(attempt) + "/", args.host + ":" + remote + "/"])
            started = True  # Launch outcome may be unknown if the connection drops.
            ssh(args.host, "cd " + qremote + " || exit; if mkdir started 2>/dev/null; then nohup python3 worker.py >worker.log 2>&1 </dev/null & fi", stdout=subprocess.DEVNULL)
        receipt["status"] = "running"
        save()
        print(f"remote-build: {args.host} queued {args.session}; receipt {receipt_path}", flush=True)
        deadline = time.monotonic() + args.queue_timeout + args.timeout + 300
        while time.monotonic() < deadline:
            try:
                check = ssh(args.host, "if test -f " + qremote + "/result.json; then cat " + qremote + "/result.json; fi", capture_output=True, text=True)
            except subprocess.CalledProcessError as exc:
                if exc.returncode != 255:
                    raise
                receipt["transport_retries"] = receipt.get("transport_retries", 0) + 1
                receipt["last_transport_error"] = (exc.stderr or str(exc))[-2000:]
                save()
                time.sleep(10 + random.random() * 5)
                continue
            if check.stdout.strip():
                receipt["remote"] = json.loads(check.stdout)
                break
            time.sleep(10 + random.random() * 5)
        else:
            raise RuntimeError("remote result deadline exceeded; attempt retained and bounded remote service may still be stopping")
        # Collect all diagnostics even for a failed build. Never reuse an older export.
        transport(args.host, ["rsync", "-a", args.host + ":" + remote + "/results/", str(attempt / "results") + "/"])
        with (attempt / "worker.log").open("wb") as worker_log:
            ssh(args.host, "cat " + qremote + "/worker.log", stdout=worker_log)
        result = receipt["remote"]["exit_code"]
        # Also protect recovery of older workers whose systemd launcher could
        # report zero after cancellation. Never publish their cached exports.
        if receipt["remote"].get("cancelled") or receipt["remote"].get("build_completed") is False:
            result = 1
            receipt["rejected_remote_success"] = "cancelled or missing build-completion evidence"
        exports = attempt / "results" / "export" / args.session
        if result == 0 and not receipt.get("no_exports", False):
            if not exports.is_dir() or not any(p.is_file() for p in exports.rglob("*")):
                raise RuntimeError("successful build returned no exports; old published exports were left unchanged")
            receipt["export_sha256"] = {str(p.relative_to(exports)): hashlib.sha256(p.read_bytes()).hexdigest()
                                         for p in exports.rglob("*") if p.is_file()}
            # Serialize publication of the compatibility directory across local processes.
            import fcntl
            pub = out / "export-remote"
            pub.mkdir(exist_ok=True)
            with (pub / ".publish.lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                dest = pub / args.session
                temp = pub / ("." + args.session + "-" + attempt_id)
                if temp.exists():
                    shutil.rmtree(temp)  # Our own prior incomplete publication.
                shutil.copytree(exports, temp)
                if dest.exists() or dest.is_symlink():
                    # Preserve previous artifacts; they may belong to another session.
                    dest.rename(pub / (args.session + ".previous-" + attempt_id + "-" + uuid.uuid4().hex[:6]))
                os.replace(temp, dest)
            receipt["exports_published"] = True
        log = attempt / "results" / "build.log"
        if log.exists():
            shutil.copy2(log, out / "remote-build.log")
            print("\n".join(log.read_text(errors="replace").splitlines()[-8:]))
        receipt["status"] = ("checked" if receipt.get("check_only") else "passed") if result == 0 else "failed"
        # Only the attempt this invocation created is removed, after complete collection.
        try:
            ssh(args.host, "rm -rf -- " + qremote)
        except subprocess.CalledProcessError as exc:
            receipt["remote_cleanup_error"] = str(exc)
    except (Exception, KeyboardInterrupt) as exc:
        receipt["status"] = ("interrupted" if isinstance(exc, KeyboardInterrupt) else
                             "collection_failed" if "remote" in receipt else
                             "remote_unknown" if started else "failed")
        receipt["error"] = str(exc)
        result = 130 if isinstance(exc, KeyboardInterrupt) else 1
        if started and "remote" not in receipt and isinstance(exc, KeyboardInterrupt):
            try:
                ssh(args.host, "touch " + qremote + "/cancel", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        print("remote-build: " + str(exc), file=sys.stderr)
    finally:
        receipt["finished"] = time.time()
        receipt["exit_code"] = result
        save()
        print(f"remote-build: {args.host} {args.session} exit {result}; receipt {receipt_path}", flush=True)
    return result


if __name__ == "__main__":
    sys.exit(main())
