+    r"flow(?: rate)?|temperature|stiffness|efficiency)\s+(?:is|remains|stays)\s+"
+    r"(?:constant|steady|fixed)(?:\s+throughout)?\s*[.!]?$", re.I)
+CONDITION_PARAMETER = re.compile(
+    r"\b(?:specific heat|heat capacity|gravity|density|efficiency|temperature|pressure|mass|volume|"
