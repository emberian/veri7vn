+def _condition_prefix(part: str) -> tuple[str, str]:
+    """Separate explicit declarative conditions from a later independent task.
+
+    Only condition-led sentences without an unquoted question or request verb
+    attach backwards. A new question stays separate even when its preceding
+    sentence starts with 'Use'. Quoted/code text is never a split boundary.
+    This is deliberately a small untrusted English recognizer, not a proof that
+    arbitrary prose expresses only conditions.
+    """
+    masked = CODE_SPAN.sub(lambda m: "\x00" * len(m.group(0)), part)
+    # A 'Given ...' premise before another question normally belongs to that
+    # new question; it is only a backwards continuation when no question follows.
+    if re.match(r"^(?:please\s+)?given\b", masked, re.I) and "?" in masked:
+        return "", part
+    ends = [m.end() for m in re.finditer(r"[.!]\s+", masked)] + [len(part)]
+    start, consumed = 0, 0
+    for end in ends:
+        sentence = masked[start:end].strip()
+        if not sentence:
+            start = end
+            continue
+        if not (CONDITION_START.match(sentence) or DECLARED_CONSTANT.fullmatch(sentence)) or "?" in sentence or CONDITION_NEW_TASK.search(sentence):
+            break
+        if re.match(r"^(?:please\s+)?(?:use|using|take)\b", sentence, re.I) and not CONDITION_PARAMETER.search(sentence):
+            break  # "Take the square root ..." / "Use a calculator ..." is a task, not a model input.
+        consumed = end
+        start = end
+    return part[:consumed].strip(), part[consumed:].strip()
+
+
+def _short_followup_fragment(text: str) -> bool:
+    """A small explicit elliptical vocabulary; brevity alone never implies dependence."""
+    return bool(re.fullmatch(
+        r"\s*(?:and\s+)?(?:how\s+(?:many|much|long|far)|what(?:\s+else)?|who|when|where|why|which(?:\s+one)?)\s*[?!.]*\s*",
+        text, re.I))
+
+
