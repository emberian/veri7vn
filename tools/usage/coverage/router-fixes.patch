+def _programming_language(qid):
+    """Positive bounded P31/P279 evidence only; missing ancestry is not a negative fact."""
+    db = _load()["db"]
+    frontier, seen = {qid}, set()
+    for depth in range(5):
+        if 9143 in frontier and depth > 0:
+            return True
+        next_frontier = set()
+        for item in frontier - seen:
+            rows = db.execute("SELECT o FROM fact INDEXED BY fact_sp WHERE s=? AND p=? LIMIT 33",
+                              (item, 31 if depth == 0 else 279)).fetchall()
+            if len(rows) > 32:
+                return False
+            next_frontier.update(o for (o,) in rows if o is not None)
+        seen.update(frontier)
+        if len(seen | next_frontier) > 64:
+            return False
+        frontier = next_frontier - seen
+        if not frontier:
+            return False
+    return False
