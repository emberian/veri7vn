+        return "I can calculate one shape at a time; this request refers to multiple shapes."
+    for requested in re.finditer(r"\b(?:in|into|to)\s+(?:(square|cubic|sq\.?|cu\.?)\s+|(units?\s+of)\s+)?([a-z]+)(?:\^?[23]|[²³])?\b", asking):
+        if requested.group(1) or requested.group(2) or requested.group(3) in _LENGTHS:
+            return "I cannot yet bind an explicitly requested output unit for this geometry calculation."
+    return None
