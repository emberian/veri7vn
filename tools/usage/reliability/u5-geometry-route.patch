+def _unit_at(tail, strict=False):
+    tail = tail.lstrip()
+    if re.match(r"in\s+(?:the|this|a)\s+(?:diagram|drawing|figure)\b", tail):
+        return None, True, None
+    word = re.match(r"([^\W\d_]+)", tail)
+    if not word:
+        return None, False, None
+    token = word.group(1)
+    if token in _LENGTHS:
+        rest = tail[word.end():].lstrip()
+        if re.match(r"(?:\^|\d|[²³]|/|per\b)", rest):
+            return None, False, "These dimensions require length units, not powered or compound units."
+        if token == "in" and rest and not re.match(r"[.,;:?!)]|(?:and|long|wide|tall|high)\b", rest):
+            return None, False, "I cannot tell whether 'in' denotes inches or a preposition here. Please spell out the length unit."
+        return _LENGTHS[token], False, None
+    if strict and token not in ("and", "or", "by", "x", "units", "unit", "long", "wide", "high", "tall"):
+        return None, False, "I cannot bind the stated length unit '%s'; please use an explicit supported length unit." % token
+    return None, False, None
+
+
+def _dimensions(t):
+    fields, positions, units, diagram = {}, set(), [], False
+    for match in _FIELDS.finditer(t):
+        role, raw = match.group(1), match.group(2)
+        unit, drawn, error = _unit_at(t[match.end():], strict=True)
+        if error:
+            return None, None, False, error
+        record = (float(raw), unit)
+        if role in fields:
+            previous = fields[role]
+            if (previous[1] is None) != (unit is None) or previous[0] * (previous[1][1] if previous[1] else 1) != record[0] * (unit[1] if unit else 1):
+                return None, None, False, "The supplied %s values contradict each other; please supply one consistent measurement." % role
+        fields[role] = record
+        positions.add(match.start(2))
+        units.append(unit)
+        diagram = diagram or drawn
+    # A unit or diagram dimension not bound to an explicit role cannot be
+    # silently fed to the old first-number reader.
+    for number in _NUMBERS.finditer(t):
+        unit, drawn, error = _unit_at(t[number.end():])
+        if error:
+            return None, None, False, error
+        if (unit or drawn) and number.start(1) not in positions:
+            return None, None, False, "I cannot bind every supplied length to a geometry role; please name each dimension explicitly."
+        if (any(units) or diagram) and number.start(1) not in positions:
+            # Explicit apartment identifiers are not shape dimensions. Other
+            # unused numbers (including a second '5 by 6' tuple) remain ambiguous.
+            if not re.search(r"\bapartment\s*$", t[:number.start(1)]):
+                return None, None, False, "I cannot account for every number in this dimensional request; please clarify the extra dimensions or constraints."
+    return fields, units, diagram, None
+
+
+def _request_issue(t):
+    asking = re.split(r"(?<=[.!?])\s+", t)[-1]
