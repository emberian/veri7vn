+def duration_hours(low):
+    durations = [num(m[1]) for m in re.finditer(QN + r"\s*(?:hours?|hrs?|h|minutes?)\b", low)]
+    if any(not math.isfinite(x) or x < 0 for x in durations):
+        raise ValueError("a finite nonnegative load duration")
+    if len(durations) > 1:
+        raise ValueError("one unambiguous load duration")
+    duration = hours(low)
+    if duration is not None and not math.isfinite(duration[0]):
+        raise ValueError("a finite load duration")
+    return duration
