+        if re.search(QN + r"\s*ah\b", low):
+            volts = [num(m[1]) for m in re.finditer(QN + r"\s*v(?:olts?)?\b", low)]
+            amps = [num(m[1]) for m in re.finditer(QN + r"\s*ah\b", low)]
+            equivalent = one_value(volts, "battery voltage") * one_value(amps, "battery capacity in Ah")
+            if not math.isclose(energy, equivalent, rel_tol=1e-9, abs_tol=1e-9):
+                raise ValueError("consistent Wh and voltage/amp-hour capacity values")
+        return energy
+    volts = [num(m[1]) for m in re.finditer(QN + r"\s*v(?:olts?)?\b", low)]
