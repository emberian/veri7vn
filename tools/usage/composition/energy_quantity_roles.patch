+def load_and_rating(low):
+    """Untrusted grammar: inverter rating is a constraint, never consumed power."""
+    loads, ratings, unbound = [], [], []
+    for m in POWER.finditer(low):
+        value = num(m[1]) * (1000 if m[2].startswith("k") else 1)
+        before, after = low[max(0, m.start()-55):m.start()], low[m.end():m.end()+55]
+        is_rating = (re.match(r"\s*(?:rated\s+)?inverter\b", after)
+                     or re.search(r"\binverter(?:\s+(?:rating|rated|is|of|at|for|has|a))*(?:\s*[:=])?\s*$", before)
+                     or re.match(r"\s*(?:inverter\s+)?(?:rating|rated)\b", after))
+        is_load = (re.match(r"\s*(?:(?:ac|dc|constant)\s+)?" + DEVICE, after)
+                   or re.search(r"\b(?:load|device|appliance)\s*(?:(?:draws|uses|is|of|at)\s*)?[:=]?\s*$", before))
+        if is_rating and not is_load:
+            ratings.append(value)
+        elif is_load and not is_rating:
+            loads.append(value)
+        else:
+            unbound.append(value)
+    if not loads and len(unbound) == 1 and not ratings:
+        loads, unbound = unbound, []  # the legacy single-load form
+    if unbound:
+        raise ValueError("the consumed load and inverter rating labelled separately")
+    if len(loads) != 1:
+        raise ValueError("one total consumed load in watts")
+    load = one_value(loads, "consumed load in watts")
+    rating = one_value(ratings, "inverter rating in watts") if ratings else None
+    if load <= 0:
+        raise ValueError("a consumed load greater than zero watts")
+    if rating is not None and load > rating:
+        raise ValueError("a load within the stated inverter rating")
+    return load, rating
