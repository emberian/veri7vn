+def energy_factors(low, storage=False):
+    """Bind each stated fraction to its role, or reject an unbound condition.
+
+    These are simple constant-energy models, not battery chemistry or a proof.
+    Efficiency and loss are alternative descriptions of the same conversion;
+    depth of discharge is a separate capacity fraction.
+    """
+    check_energy_conditions(low)
+    if (not storage and re.search(r"\b(?:charging|storage)\s+efficiency\b", low)) or (storage and re.search(r"\binverter\s+efficiency\b", low)):
+        raise ValueError("an efficiency bound to the requested conversion (charging and load supply are different stages)")
+    groups = {
+        "efficiency": r"(?:(?:inverter|overall|conversion|charging|storage|battery)\s+)?efficiency",
+        "depth": r"(?:depth of discharge|usable (?:depth|capacity|fraction)|discharge depth)",
+        "loss": r"(?:(?:inverter|conversion|charging|storage|system)\s+)?loss(?:es)?",
+    }
+    if storage:
+        groups["stored"] = r"(?:stored fraction|storage fraction)"
+    found, spans = {}, []
+    numeric = r"([+-]?(?:\d+(?:\.\d+)?|\.\d+))\s*(%?)"
+    for role, label in groups.items():
+        patterns = [r"(?<![\w.])" + numeric + r"\s+" + label + r"\b",
+                    r"\b" + label + r"\s*(?:(?:of|is|=|:)\s*)?" + numeric + r"(?![\w.])"]
+        if role == "efficiency":
+            patterns.append(r"(?<![\w.])" + numeric + r"\s+efficient(?:\s+inverter)?\b")
+        if role == "stored":
+            patterns.append(r"\b(?:stores|store|retains|retain)\s+" + numeric + r"\s+of\b")
+        for pattern in patterns:
+            for m in re.finditer(pattern, low):
+                f = float(m[1]) / (100 if m[2] else 1)
+                if not math.isfinite(f) or not 0 <= f <= 1:
+                    raise ValueError("efficiency, loss and usable fractions between 0 and 1 (or 0% and 100%)")
+                found.setdefault(role, []).append(f)
+                spans.append(m.span())
+    # Every percentage and every adjustment term must be accounted for. Ignoring
+    # losses is an explicit ideal-model assumption, not an unknown loss factor.
+    masked = list(low)
+    for start, end in spans:
+        masked[start:end] = " " * (end-start)
+    rest = "".join(masked)
+    rest = re.sub(r"\b(?:ignoring|ignore|without|no|neglecting)\s+(?:(?:inverter|conversion)\s+)?loss(?:es)?\b", "", rest)
+    if re.search(r"%|\befficien\w*|\bloss(?:es)?\b|\bdepth of discharge\b|\busable (?:depth|capacity|fraction)\b|\b(?:idle|standby|variable|surge|peukert|temperature|degradation|derate|reserve)\b|\bperformance ratio\b|\b(?:half full|partly charged|partially charged|state of charge)\b", rest):
+        raise ValueError("each loss, efficiency, usable-capacity or variable-load condition explicitly bound to this model")
+    factors = {role: one_value(values, role + " fraction") for role, values in found.items()}
+    efficiency = factors.get("efficiency", 1)
+    if "loss" in factors:
+        retained = 1 - factors["loss"]
+        if "efficiency" in factors and not math.isclose(efficiency, retained, abs_tol=1e-12):
+            raise ValueError("consistent efficiency and loss fractions")
+        efficiency = retained
+    if "stored" in factors:
+        if "efficiency" in factors or "loss" in factors:
+            if not math.isclose(efficiency, factors["stored"], abs_tol=1e-12):
+                raise ValueError("one unambiguous stored fraction (not two unexplained conversion stages)")
+        efficiency = factors["stored"]
+    return efficiency, factors.get("depth", 1), bool(found)
+
