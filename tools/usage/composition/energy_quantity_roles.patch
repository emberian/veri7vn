+def check_energy_conditions(low):
+    for m in re.finditer(r"(?<![\w.,])[+-]?\d[\d,.]*", low):
+        token = m[0].rstrip(".")
+        if "," in token and not re.fullmatch(r"[+-]?\d{1,3}(?:,\d{3})+(?:\.\d+)?", token):
+            raise ValueError("numbers with unambiguous decimal points and three-digit comma groups")
+    if re.search(r"\bbatteries\b|\b(?:loads|devices|appliances|fridges|lights|laptops|lamps|fans|routers|pumps|heaters|bulbs|motors)\b", low):
+        raise ValueError("one battery source and one total consumed load; multiple sources or loads need an explicit combined model")
+
+
+def one_value(values, description):
+    if not values:
+        raise ValueError(description)
+    if len(set(values)) != 1:
+        raise ValueError("one unambiguous " + description)
+    value = values[0]
+    if not math.isfinite(value) or value < 0:
+        raise ValueError("a finite nonnegative " + description)
+    return value
+
+
+def capacity_wh(low):
+    check_energy_conditions(low)
+    values = [num(m[1]) * (1000 if m[2] == "kwh" else 1)
+              for m in re.finditer(QN + r"\s*(kwh|wh)\b", low)]
+    if values:
