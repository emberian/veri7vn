theory Mathematics_Exact_Tests
  imports "Veri7vn_Mathematics.Mathematics_ASCII" "Veri7vn_Mathematics.Mathematics_Real_Guards" "Veri7vn_Mathematics.Mathematics_Solutions" "Veri7vn_Mathematics.Mathematics_Parameters"
    "Veri7vn_Mathematics_Profiles.Mathematics_Profiles"
    "Veri7vn_Mathematics_Examples.Exact_Mathematics_Example"
begin
lemma zero_over_zero: "math_eval (\<lambda>_. None) (Divide (Rational 0) (Rational 0)) = None"
  by simp
lemma undefined_not_equal:
  "math_equal (\<lambda>_. None) (Divide (Rational 0) (Rational 0)) (Rational 1) = None"
  by (simp add: math_equal_def)
lemma negative_branch: "\<not> principal_root_witness ((-2)*(-2)) (-2)"
  by (simp add: principal_root_witness_def)
lemma negative_branch_repaired: "principal_root_witness ((-2)*(-2)) 2"
  by (simp add: principal_root_witness_def)
lemma precision_repaired:
  "\<not> within_tolerance (1/10^40) 1 (1+1/10^20)"
  by (simp add: within_tolerance_def)
lemma small_interval_complete:
  "square_interval (1/10) x \<longleftrightarrow> x*x < 1/100"
  using square_interval_complete[of "1/10" x] by simp
lemma endpoints_excluded:
  "\<not> square_interval (1/10) (1/10) \<and> \<not> square_interval (1/10) (-1/10) \<and> square_interval (1/10) 0"
  by (simp add: square_interval_def)
lemma invalid_stack_rejected:
  "parse_math [PlusToken] = None"
  by (simp add: parse_math_def)
lemma undefined_arithmetic_distinct_from_syntax:
  "evaluate_tokens (\<lambda>_. None) [FractionToken 0 1, FractionToken 0 1, DivideToken] = Some None"
  by (simp add: evaluate_tokens_def parse_math_def)
lemma exact_fraction:
  "evaluate_tokens (\<lambda>_. None) [FractionToken 1 3, FractionToken 1 6, PlusToken] = Some (Some (1/2))"
  by (simp add: evaluate_tokens_def parse_math_def)
lemma linear_degenerate:
  "solve_linear 0 0 = AllRationals \<and> solve_linear 0 1 = NoSolutions"
  by (simp add: solve_linear_def)
lemma constant_retained:
  "primitive_instance (Antiderivative []) c = [(0,c)]"
  by (simp add: polynomial_primitive_def)
lemma inert_fixed_print_rejected:
  "evaluate_ascii 100 20 50 (\<lambda>_. None)
   [112,114,105,110,116,40,55,51,49,57,52,50,41] = SyntaxRejected"
  by (simp add: evaluate_ascii_def ascii_words_def word_step_def ascii_whitespace_def read_unsigned_def missing_math_parameters_def Let_def)
lemma ascii_division_undefined:
  "evaluate_ascii 100 20 50 (\<lambda>_. None) [48,32,48,32,47] = Computed None"
  by (simp add: evaluate_ascii_def ascii_words_def word_step_def ascii_whitespace_def read_unsigned_def missing_math_parameters_def Let_def evaluate_tokens_def parse_math_def)
definition precision_tolerance :: rat where "precision_tolerance = 1/10^40"
definition precision_left :: rat where "precision_left = 1"
definition precision_right :: rat where "precision_right = 1+1/10^20"

text \<open>Exercise the actual generated byte parser/evaluator, not a Python adapter.\<close>
ML \<open>
  local
    val n = Veri7vn_Numerals.nat_of_integer;
    fun run bytes = @{code evaluate_ascii} (n 100) (n 20) (n 50)
      (fn _ => NONE) (map n bytes);
    val _ = if not (@{code within_tolerance} @{code precision_tolerance}
      @{code precision_left} @{code precision_right}) then ()
      else error "generated exact tolerance lost precision";
    val _ = (case run [112,48] of @{code ParametersMissing} [_] => ()
      | _ => error "generated parser confused missing parameter with undefined arithmetic");
    val _ = (case run [48,32,48,32,47] of @{code Computed} NONE => ()
      | _ => error "generated zero division lost partiality");
    val _ = (case run [112,114,105,110,116,40,55,51,49,57,52,50,41] of
      @{code SyntaxRejected} => () | _ => error "generated parser accepted host text");
    val _ = (case run [50,32,94,53,49] of @{code BoundExceeded} => ()
      | _ => error "generated exponent bound bypassed");
  in
    val _ = writeln "VERI7VN_MATH generated_partial_parser PASS";
  end;
\<close>

ML \<open>
  local
    structure R = Veri7vn_Native_Registry;
    structure P = Veri7vn_Native_Profiles;
    structure M = Veri7vn_Mathematics_Profiles;
    val generation = R.generation @{context} {packages=["mathematics"],
      runtime="mathematics-native-test", policy="test-only", sources=[], interpretation="postfix-ascii"};
    val (profiles, registry) = M.declare generation R.empty;
    val rational = M.rational profiles;
    val symbolic = M.symbolic profiles;
    val _ = if R.same_generation (P.owner rational,generation) andalso
      not (P.same_declaration (rational,symbolic)) then ()
      else error "family profile identity lost";
    val _ = List.app (fn handle_ => case R.lookup generation handle_ registry of
      R.Theorem _ => () | _ => error "profile evidence is not a native theorem")
      (#dependencies (P.inspect rational));
  in
    val _ = writeln "VERI7VN_MATH native_profiles PASS";
  end;
\<close>



end
